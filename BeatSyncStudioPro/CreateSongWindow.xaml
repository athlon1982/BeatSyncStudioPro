<Window x:Class="BeatSyncStudioPro.CreateSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Song" Icon="/Assets/app.ico"
        Width="640" Height="700" MinWidth="520" MinHeight="560"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎤 Create Song" FontSize="16" FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Title" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A0A5B5"/>
            <TextBox x:Name="TitleBox" Grid.Column="1" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4" Text="My New Song"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Style" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A0A5B5"/>
                <TextBox x:Name="StyleBox" Grid.Column="1" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"
                         Text="hip-hop, boom-rap, heavy 808 sub-bass, hard-hitting bass, country rap, Vermont"/>
            </Grid>
            <WrapPanel x:Name="StyleChips" Grid.Row="1" Margin="34,6,0,0"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Lyrics" Foreground="#A0A5B5" Margin="0,0,0,4"/>
            <TextBox x:Name="LyricsBox" Grid.Row="1" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8,6"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="[Verse]&#x0a;Write your lyrics here — or generate them in the AI Lab first and press 'Create Song from this…'.&#x0a;&#x0a;[Chorus]&#x0a;..."/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Style Influence" VerticalAlignment="Center" Foreground="#A0A5B5"/>
            <Slider x:Name="StyleInfSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="StyleInfValue" Grid.Column="2" Text="70" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="Voice Influence" VerticalAlignment="Center" Foreground="#A0A5B5"/>
            <Slider x:Name="VoiceInfSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="VoiceInfValue" Grid.Row="1" Grid.Column="2" Text="70" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="2" Text="Weirdness" VerticalAlignment="Center" Foreground="#A0A5B5"/>
            <Slider x:Name="WeirdSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="30" VerticalAlignment="Center" ValueChanged="Slider_Changed"/>
            <TextBlock x:Name="WeirdValue" Grid.Row="2" Grid.Column="2" Text="30" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Voice" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A0A5B5"/>
            <ComboBox x:Name="VoicePicker" Grid.Column="1">
                <ComboBoxItem Content="Generated voice (as the model sings it)"/>
                <ComboBoxItem Content="👑 Rad-Dad — my voice" IsSelected="True"/>
            </ComboBox>
            <TextBlock Text="Length" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="#A0A5B5"/>
            <ComboBox x:Name="DurationPicker" Grid.Column="3" Width="90" SelectedIndex="3">
                <ComboBoxItem Content="30 sec"/>
                <ComboBoxItem Content="60 sec"/>
                <ComboBoxItem Content="2 min"/>
                <ComboBoxItem Content="3 min"/>
                <ComboBoxItem Content="4 min"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Beat" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A0A5B5"/>
            <TextBox x:Name="BpmBox" Grid.Column="1" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"
                     Text="95" ToolTip="Beat tempo (BPM)"/>
            <Button Grid.Column="2" Content="🥁 Auto-make the beat" Click="AutoBeat_Click" Margin="8,0,0,0" Padding="12,5"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                    ToolTip="Builds a beat in your style from the built-in generator, adds it as an editable pattern and a loop in your library"/>
            <TextBlock x:Name="BeatText" Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Text="No backing beat yet — make one, then layer the generated song over it on the timeline."/>
        </Grid>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="GenerateButton" Content="🎤 Generate Song" Click="Generate_Click" Padding="18,8"
                    Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Padding="14,8" Margin="8,0,0,0" IsEnabled="False"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <TextBlock x:Name="ComputeText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#A0A5B5" FontSize="11"/>
        </StackPanel>

        <TextBlock Grid.Row="8" x:Name="StatusText" Margin="0,10,0,0" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</Window>
