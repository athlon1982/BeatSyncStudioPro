<UserControl x:Class="BeatSyncStudioPro.MixkitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E222B" Foreground="#FFFFFF">
    <StackPanel Margin="14" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="🎚 Mixkit — why there's no search here" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Margin="0,10,0,0" Foreground="#A0A5B5" FontSize="12" TextWrapping="Wrap"
                   Text="Mixkit (mixkit.co, by Envato) has a great free music and sound-effects library — but no API of any kind, and its User Terms expressly forbid using scripts or bots to access or download its catalog. A built-in search panel would have to scrape their site, which is exactly what those terms prohibit — so BeatSync doesn't do it. (Same call as Free Music Archive, whose API was shut down.)"/>
        <TextBlock Margin="0,10,0,0" Foreground="#A0A5B5" FontSize="12" TextWrapping="Wrap"
                   Text="The legitimate route is one click longer: open Mixkit in your browser, find a track, and download it there like any visitor. Then bring it into BeatSync with the Song Library's Import (files, folders, or whole ZIPs) or the Sound Library import — it'll be analyzed, categorized, and ready for the decks."/>
        <Button Content="🌐 Open Mixkit free music in your browser" Click="OpenMixkit_Click" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,8"
                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"
                   Text="If Mixkit ever ships a public API, this tab becomes a real search panel — the door is open, the terms just have to allow it."/>
    </StackPanel>
</UserControl>
