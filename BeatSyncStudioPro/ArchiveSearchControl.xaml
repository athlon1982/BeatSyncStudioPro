<UserControl x:Class="BeatSyncStudioPro.ArchiveSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E222B" Foreground="#FFFFFF">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎵 Full-length music — songs, live concerts, albums, old-time radio. No account, no key: the Archive is open."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8,6"
                     KeyDown="QueryBox_KeyDown" ToolTip="an artist, a song, a sound — live concerts, old-time radio, netlabel albums, field recordings…"/>
            <ComboBox x:Name="ScopePicker" Grid.Column="1" Width="150" Margin="8,0,0,0" VerticalAlignment="Center"
                      ToolTip="Where on the Archive to hunt: everything, the Live Music Archive's concert recordings, netlabels (free online record labels), or community uploads.">
                <ComboBoxItem Content="🎵 All audio" IsSelected="True"/>
                <ComboBoxItem Content="🎤 Live Music (concerts)"/>
                <ComboBoxItem Content="💿 Netlabels"/>
                <ComboBoxItem Content="🌐 Community Audio"/>
            </ComboBox>
            <Button x:Name="SearchButton" Grid.Column="2" Content="🔎 Search" Click="Search_Click" Margin="8,0,0,0" Padding="16,6"
                    Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <ListBox x:Name="ResultsList" Grid.Row="2" Margin="0,10,0,0" Background="#14171E" Foreground="White" BorderBrush="#333"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="▶ Preview" Click="Preview_Click" Padding="14,6"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="⬇ Add to Library" Click="Add_Click" Margin="8,0,0,0" Padding="14,6"
                    Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,8,0,0" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"
                   Text="Search the Internet Archive's enormous free library. Tracks are MP3s from the original uploads; licenses and creators are shown so credit is one copy-paste away."/>
    </Grid>
</UserControl>
