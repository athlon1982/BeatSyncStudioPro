<Window x:Class="BeatSyncStudioPro.BeatGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beat Grid" Icon="/Assets/app.ico"
        Width="400" Height="340" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="🥁 Beat Grid" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="A beat grid draws beat lines on the timeline (every 4th is a downbeat) and lets clips snap to the beat when you drag them."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"/>
        <Button x:Name="DetectButton" Content="🔍 Detect from the first song clip" Click="Detect_Click" Height="34"
                Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        <TextBlock x:Name="DetectStatus" Text="" Foreground="#A0A5B5" FontSize="11" Margin="0,6,0,2" TextWrapping="Wrap"/>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="BPM" Foreground="#A0A5B5" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="BpmBox" Grid.Column="1" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"/>
        </Grid>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="First beat at" Foreground="#A0A5B5" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="OffsetBox" Grid.Column="1" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"/>
        </Grid>
        <TextBlock Text="seconds into the timeline (usually where the first kick lands). Set BPM to 0 to clear the grid."
                   Foreground="#666666" FontSize="10" Margin="110,4,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="84" Height="32" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Apply" Click="Ok_Click" Width="84" Height="32" Margin="8,0,0,0" Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
