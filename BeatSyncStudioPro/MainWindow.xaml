<Window x:Class="BeatSyncStudioPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BeatSync Studio Pro" Icon="/Assets/app.ico" Height="800" Width="1400" WindowState="Maximized" MinWidth="900" MinHeight="600"
        Background="#14171E" Foreground="#FFFFFF" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main menu bar -->
        <Menu Grid.Row="0" Grid.ColumnSpan="2" Background="#1E222B" Foreground="White" Padding="6,2" BorderBrush="#333" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Padding="10,4">
                <MenuItem Header="📂 Open Project..." Click="BtnOpenProject_Click"/>
                <MenuItem Header="💾 Save Project" Click="BtnSave_Click"/>
                <Separator/>
                <MenuItem Header="💾 Export Audio (WAV / MP3)..." Click="BtnExportAudio_Click"/>
                <MenuItem Header="🎬 Export Video..." Click="BtnExport_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Import" Padding="10,4">
                <MenuItem Header="🎬 Video Files..." Click="BtnImportVideo_Click"/>
                <MenuItem Header="🖼️ Image Files..." Click="BtnImportImages_Click"/>
                <MenuItem Header="🎵 Audio / MIDI / ZIP..." Click="BtnImportAudioOrZip_Click"/>
            </MenuItem>
            <MenuItem Header="_Tracks" Padding="10,4">
                <MenuItem Header="➕ Add Audio Track" Click="BtnAddTrack_Click"/>
                <MenuItem Header="➖ Remove Audio Track" Click="BtnRemoveTrack_Click"/>
                <Separator/>
                <MenuItem Header="🎬 Add Video to Timeline" Click="BtnAddVideoToTimeline_Click"/>
                <MenuItem Header="🗑️ Remove Video Track" Click="BtnRemoveVideo_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Padding="10,4">
                <MenuItem Header="🎚️ Mixer" Click="BtnMixer_Click"/>
                <MenuItem Header="📺 Output Window" Click="BtnOutput_Click"/>
            </MenuItem>
            <MenuItem Header="_Help" Padding="10,4">
                <MenuItem Header="About BeatSync Studio Pro" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ASSET LIBRARY SIDEBAR -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1E222B" Margin="10" CornerRadius="10" Padding="15" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🎬 Asset Library" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#E2E8F0"/>

                <!-- Quick Import Buttons (the full import menu lives in the top menu bar) -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,8">
                    <Button Content="🎬 Quick Video" Click="BtnImportVideo_Click" Padding="10,8" Margin="0,0,0,6" Background="#7B1FA2" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Height="36"/>
                    <Button Content="🖼️ Quick Images" Click="BtnImportImages_Click" Padding="10,8" Margin="0,0,0,6" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Height="36"/>
                    <Button Content="🎵 Quick Audio" Click="BtnImportAudioOrZip_Click" Padding="10,8" Background="#1DB954" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Height="36"/>
                </StackPanel>

                <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ListContainer"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MAIN SEQUENCER WORKSPACE -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="5,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4*" MinHeight="240"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Video preview -->
            <Border Grid.Row="0" Background="#0E1116" CornerRadius="10" Margin="10,5" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <MediaElement x:Name="MasterVideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"/>
                    <TextBlock Text="📹 No Video Loaded" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" x:Name="NoVideoLabel"/>
                </Grid>
            </Border>

            <!-- Timeline header with professional controls -->
            <Border Grid.Row="1" Background="#1E222B" Margin="10,5" CornerRadius="6" Padding="15" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <TextBlock Text="⏱️ Multitrack Timeline Editor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🎬 Add Video" Click="BtnAddVideoToTimeline_Click" Padding="10,6" Margin="0,0,8,0" Background="#7B1FA2" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Height="36"/>
                        <Button Content="➕ Add Audio Track" Click="BtnAddTrack_Click" Padding="10,6" Margin="0,0,8,0" Background="#1DB954" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Height="36"/>
                        <Button Content="➖ Remove Audio Track" Click="BtnRemoveTrack_Click" Padding="10,6" Margin="0,0,8,0" Background="#A12424" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Height="36"/>
                        <Button Content="🗑️ Remove Video Track" Click="BtnRemoveVideo_Click" Padding="10,6" Background="#7B1FA2" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Timeline area with ruler and tracks -->
            <Grid Grid.Row="2" Margin="10,5" Background="#0E1116">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Time ruler (corner stays fixed; the ticks scroll with the timeline) -->
                <Grid Grid.Row="0" Background="#232731">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1E222B">
                        <TextBlock Text="Timeline" Foreground="#A0A5B5" FontWeight="Bold" FontSize="10" Margin="15,12,0,0"/>
                    </Border>
                    <Canvas Grid.Column="1" ClipToBounds="True">
                        <Canvas x:Name="RulerTicksCanvas">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="RulerShift"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Grid>

                <!-- Tracks area -->
                <Grid Grid.Row="1">
                    <!-- Track labels sidebar -->
                    <StackPanel x:Name="HeadersSidebar" Width="140" HorizontalAlignment="Left" Background="#14171E"/>

                    <!-- Scrollable timeline: clips and waveforms share one host so they scroll together -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="140,0,0,0" x:Name="TimelineScrollViewer" ScrollChanged="TimelineScrollViewer_ScrollChanged">
                        <Grid x:Name="TimelineHost" Width="2500" Height="450">
                            <Canvas x:Name="TimelineCanvas" Width="2500" Height="450" Background="#14171E" MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp" AllowDrop="True" DragOver="TimelineCanvas_DragOver" Drop="TimelineCanvas_Drop"/>
                            <Canvas x:Name="WaveformOverlayCanvas" Width="2500" Height="450" IsHitTestVisible="False" Background="Transparent"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Professional mixer footer -->
            <Border Grid.Row="3" Background="#1E222B" CornerRadius="6" Padding="15" Margin="10,5" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="▶ Play" Click="BtnPlay_Click" Width="100" Height="40" Margin="0,0,8,0" Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="⏸ Pause" Click="BtnPause_Click" Width="100" Height="40" Margin="0,0,8,0" Background="#1568DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="⏹ Stop" Click="BtnStop_Click" Width="100" Height="40" Background="#A12424" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="🎚️ Mixer" Click="BtnMixer_Click" Width="100" Height="40" Margin="8,0,0,0" Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="💾 Export" Click="BtnExportAudio_Click" Width="100" Height="40" Margin="8,0,0,0" Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="📺 Output" Click="BtnOutput_Click" Width="100" Height="40" Margin="8,0,0,0" Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Separator Width="1" Background="#333" Margin="5,0"/>
                        <Button x:Name="BtnMasterMute" Content="🔊" Click="BtnMute_Click" Width="50" Height="40" Background="#2A303C" Foreground="#A0A5B5" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Text="Master" Foreground="#A0A5B5" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"/>
                        <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="1" Value="0.8" Width="120" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumePercent" Text="80%" Foreground="#A0A5B5" VerticalAlignment="Center" Width="40" FontSize="11" TextAlignment="Right"/>
                        <TextBlock x:Name="TimeDisplay" Text="0:00 / 0:00" Foreground="White" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>

                    <TextBlock Text="Created by Michael DeCato" Foreground="#666666" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
