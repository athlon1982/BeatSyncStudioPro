<Window x:Class="BeatSyncStudioPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BeatSync Studio Pro" Icon="/Assets/app.ico" Height="800" Width="1400" WindowState="Maximized" MinWidth="900" MinHeight="600"
        PreviewKeyDown="Window_PreviewKeyDown"
        Foreground="#FFFFFF" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0D13" Offset="0"/>
            <GradientStop Color="#16203A" Offset="0.45"/>
            <GradientStop Color="#1D1033" Offset="0.78"/>
            <GradientStop Color="#0A0D13" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- DJ glow-up (v3.22): gradient fills + neon glows so the main
             window carries the splash screen's energy — Michael: "the
             splash makes u get excited, then open the app and it looks
             bland… make it pop like a DJ setup." -->
        <LinearGradientBrush x:Key="GreenGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2BE07F" Offset="0"/><GradientStop Color="#17A74C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VioletGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9D7BFF" Offset="0"/><GradientStop Color="#5B3DF0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BlueGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4C9AFF" Offset="0"/><GradientStop Color="#1256B4" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RedGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E5484D" Offset="0"/><GradientStop Color="#9E1B1B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DarkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#333E52" Offset="0"/><GradientStop Color="#202836" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#212A3C" Offset="0"/><GradientStop Color="#171E2B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandLine" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1DB954" Offset="0"/><GradientStop Color="#C9A227" Offset="0.5"/><GradientStop Color="#7C5CFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VideoFrame" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C5CFF" Offset="0"/><GradientStop Color="#2A3446" Offset="0.55"/><GradientStop Color="#1DB954" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="GlowGreen" Color="#1DB954" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="GlowViolet" Color="#7C5CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="GlowText" Color="#1DB954" BlurRadius="8" ShadowDepth="0" Opacity="0.55"/>

        <!-- Rounded pro buttons: any background color, soft hover/press -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2A3446"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.94"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#8FB8FF" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark menu items (the stock light popups were the last un-pro corner) -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#E8ECF3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" CornerRadius="5">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="GlyphPath" Grid.Column="0" Data="M 1,6 L 5,10 L 12,1" Stroke="#1DB954"
                                      StrokeThickness="2" Visibility="Collapsed" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#7C8698"
                                           Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <Path x:Name="Arrow" Grid.Column="3" Data="M 1,1 L 6,4.5 L 1,8 Z" Fill="#7C8698"
                                      Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom" PopupAnimation="Fade">
                                    <Border Background="#1B212E" BorderBrush="#2A3446" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="220">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="14" ShadowDepth="3"/>
                                        </Border.Effect>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A3446"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A3446"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="GlyphPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#59637A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Brand bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{StaticResource BrandLine}" BorderThickness="0,0,0,2" Padding="14,7"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0D1424" Offset="0"/><GradientStop Color="#07090D" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app-icon.png" Width="34" Height="34"/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Effect="{StaticResource GlowText}"><Run Text="BEATSYNC" Foreground="#FFFFFF"/><Run Text=" STUDIO PRO" Foreground="#1DB954"/></TextBlock>
                    <Border Background="#1B212E" BorderBrush="#C9A227" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v3.28" FontSize="11" Foreground="#E8C766" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main menu bar -->
        <Menu Grid.Row="1" Grid.ColumnSpan="2" Background="#11151D" Foreground="White" Padding="6,2" BorderBrush="#2A3446" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Padding="10,4">
                <MenuItem Header="🏠 Start Screen..." Click="MenuStartScreen_Click"/>
                <MenuItem Header="📂 Open Project..." Click="BtnOpenProject_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="💾 Save Project" Click="BtnSave_Click" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="💾 Export Audio (WAV / MP3)..." Click="BtnExportAudio_Click" InputGestureText="Ctrl+E"/>
                <MenuItem Header="📋 Render Queue..." Click="BtnRenderQueue_Click"/>
                <MenuItem Header="🔁 Batch Convert..." Click="BtnBatchConvert_Click"/>
                <MenuItem Header="🎬 Export Video..." Click="BtnExport_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Import" Padding="10,4">
                <MenuItem Header="🎬 Video Files..." Click="BtnImportVideo_Click"/>
                <MenuItem Header="🖼️ Image Files..." Click="BtnImportImages_Click"/>
                <MenuItem Header="🎵 Audio / MIDI / ZIP..." Click="BtnImportAudioOrZip_Click"/>
            </MenuItem>
            <MenuItem Header="_Tracks" Padding="10,4">
                <MenuItem Header="➕ Add Audio Track" Click="BtnAddTrack_Click"/>
                <MenuItem Header="➖ Remove Audio Track" Click="BtnRemoveTrack_Click"/>
                <Separator/>
                <MenuItem Header="🎬 Add Video to Timeline" Click="BtnAddVideoToTimeline_Click"/>
                <MenuItem Header="🗑️ Remove Video Track" Click="BtnRemoveVideo_Click"/>
                <Separator/>
                <MenuItem x:Name="AutoCrossfadeMenuItem" Header="Auto-Crossfade" IsCheckable="True" IsChecked="True" Click="MenuAutoCrossfade_Click"/>
                <Separator/>
                <MenuItem Header="🥁 Beat Grid…" Click="MenuBeatGrid_Click"/>
                <MenuItem x:Name="SnapMenuItem" Header="🧲 Snap to Beat" IsCheckable="True" IsChecked="True" Click="MenuSnap_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Padding="10,4">
                <MenuItem Header="🎚️ Mixer" Click="BtnMixer_Click"/>
                <MenuItem Header="📺 Output Window" Click="BtnOutput_Click"/>
                <MenuItem Header="🎧 DJ Decks" Click="BtnDj_Click"/>
                <MenuItem Header="🥁 Patterns..." Click="BtnPatterns_Click"/>
                <MenuItem Header="🎹 Piano Roll..." Click="BtnPianoRoll_Click"/>
                <MenuItem Header="🤖 Drum Generator..." Click="BtnDrumGenerator_Click"/>
                <MenuItem Header="🔊 Monitor FX" Click="BtnMonitorFx_Click"/>
                <MenuItem Header="📝 Transcript..." Click="BtnTranscript_Click"/>
                <MenuItem Header="🎚️ Stem Splitter..." Click="BtnStemSplit_Click"/>
                <MenuItem Header="🤖 AI Lab..." Click="BtnAiLab_Click"/>
                <MenuItem Header="🎵 My Songs..." Click="BtnMySongs_Click"/>
                <MenuItem Header="🌐 Freesound Sounds..." Click="BtnFreesound_Click"/>
                <MenuItem Header="🎁 Sound Pack..." Click="BtnSoundPack_Click"/>
                <MenuItem Header="🎤 Create Song..." Click="BtnCreateSong_Click"/>
                <MenuItem Header="⬇ Downloads..." Click="BtnDownloads_Click"/>
            </MenuItem>
            <MenuItem Header="_Help" Padding="10,4">
                <MenuItem Header="⌨️ Command Palette..." Click="MenuPalette_Click" InputGestureText="Ctrl+K"/>
                <MenuItem Header="📋 Changelog..." Click="BtnChangelog_Click"/>
                <MenuItem Header="About BeatSync Studio Pro" Click="MenuAbout_Click" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <!-- ASSET LIBRARY SIDEBAR -->
        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource PanelGrad}" Margin="10" CornerRadius="10" Padding="15" BorderBrush="#2A3446" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="🎬 Asset Library" FontSize="16" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                    <Border Background="#1DB954" Height="2" Width="46" HorizontalAlignment="Left" CornerRadius="1" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Category filter + search + downloads -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,8">
                    <ComboBox x:Name="LibraryCategoryBox" SelectionChanged="LibraryFilter_Changed" Margin="0,0,0,6">
                        <ComboBoxItem Content="🗂️ All Sounds" IsSelected="True"/>
                        <ComboBoxItem Content="🥁 Drums"/>
                        <ComboBoxItem Content="🎸 Guitar"/>
                        <ComboBoxItem Content="🔊 Bass"/>
                        <ComboBoxItem Content="🎹 Keys &amp; Pads"/>
                        <ComboBoxItem Content="🔁 Loops"/>
                        <ComboBoxItem Content="🎤 Vocals"/>
                        <ComboBoxItem Content="✨ FX"/>
                        <ComboBoxItem Content="🎵 Other"/>
                        <ComboBoxItem Content="🎬 Video"/>
                        <ComboBoxItem Content="🖼️ Images"/>
                    </ComboBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LibrarySearchBox" TextChanged="LibraryFilter_Changed" Padding="8,5"
                                 Background="#14171E" Foreground="White" BorderBrush="#333"
                                 ToolTip="Search your sounds by name"/>
                        <Button Grid.Column="1" Content="⬇" Click="BtnDownloads_Click" Width="34" Margin="6,0,0,0"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                ToolTip="Downloads — progress, speed, pause and cancel"/>
                    </Grid>
                </StackPanel>

                <!-- Quick Import Buttons (the full import menu lives in the top menu bar) -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,8">
                    <Button Content="🎬 Quick Video" Click="BtnImportVideo_Click" Padding="10,8" Margin="0,0,0,6" Background="{StaticResource VioletGrad}" Foreground="White" Height="36"/>
                    <Button Content="🖼️ Quick Images" Click="BtnImportImages_Click" Padding="10,8" Margin="0,0,0,6" Background="{StaticResource DarkGrad}" Foreground="White" Height="36"/>
                    <Button Content="🎵 Quick Audio" Click="BtnImportAudioOrZip_Click" Padding="10,8" Background="{StaticResource GreenGrad}" Foreground="White" Height="36" Effect="{StaticResource GlowGreen}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ListContainer"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MAIN SEQUENCER WORKSPACE -->
        <Grid Grid.Row="2" Grid.Column="1" Margin="5,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4*" MinHeight="240"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Video preview -->
            <Border Grid.Row="0" Background="#07090D" CornerRadius="10" Margin="10,5" BorderBrush="{StaticResource VideoFrame}" BorderThickness="1.5" Effect="{StaticResource GlowViolet}">
                <Grid>
                    <MediaElement x:Name="MasterVideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"/>
                    <TextBlock Text="📹 No Video Loaded" Foreground="#93A0BC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" x:Name="NoVideoLabel"/>
                </Grid>
            </Border>

            <!-- Timeline header with professional controls -->
            <Border Grid.Row="1" Background="{StaticResource PanelGrad}" Margin="10,5" CornerRadius="8" Padding="15" BorderBrush="#2A3446" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱️ Multitrack Timeline Editor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                        <Border Background="#1DB954" Height="2" Width="40" CornerRadius="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🎬 Add Video" Click="BtnAddVideoToTimeline_Click" Padding="10,6" Margin="0,0,8,0" Background="{StaticResource VioletGrad}" Foreground="White" Height="36"/>
                        <Button Content="➕ Add Audio Track" Click="BtnAddTrack_Click" Padding="10,6" Margin="0,0,8,0" Background="{StaticResource GreenGrad}" Foreground="White" Height="36"/>
                        <Button Content="➖ Remove Audio Track" Click="BtnRemoveTrack_Click" Padding="10,6" Margin="0,0,8,0" Background="{StaticResource RedGrad}" Foreground="White" Height="36"/>
                        <Button Content="🗑️ Remove Video Track" Click="BtnRemoveVideo_Click" Padding="10,6" Background="{StaticResource VioletGrad}" Foreground="White" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Timeline area with ruler and tracks -->
            <Grid Grid.Row="2" Margin="10,5" Background="#0B0E13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Time ruler (corner stays fixed; the ticks scroll with the timeline) -->
                <Grid Grid.Row="0" Background="#1F2735">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1B212E">
                        <TextBlock Text="Timeline" Foreground="#A0A5B5" FontWeight="Bold" FontSize="10" Margin="15,12,0,0"/>
                    </Border>
                    <Canvas Grid.Column="1" ClipToBounds="True">
                        <Canvas x:Name="RulerTicksCanvas">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="RulerShift"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Grid>

                <!-- Tracks area -->
                <Grid Grid.Row="1">
                    <!-- Track labels sidebar -->
                    <StackPanel x:Name="HeadersSidebar" Width="140" HorizontalAlignment="Left" Background="#12161F"/>

                    <!-- Scrollable timeline: clips and waveforms share one host so they scroll together -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="140,0,0,0" x:Name="TimelineScrollViewer" ScrollChanged="TimelineScrollViewer_ScrollChanged">
                        <Grid x:Name="TimelineHost" Width="2500" Height="450">
                            <Canvas x:Name="TimelineCanvas" Width="2500" Height="450" Background="#10141C" MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp" AllowDrop="True" DragOver="TimelineCanvas_DragOver" Drop="TimelineCanvas_Drop"/>
                            <Canvas x:Name="WaveformOverlayCanvas" Width="2500" Height="450" IsHitTestVisible="False" Background="Transparent"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Transport / mixer footer -->
            <Border Grid.Row="3" Background="{StaticResource PanelGrad}" CornerRadius="8" Padding="15" Margin="10,5" BorderBrush="#2A3446" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="▶ Play" Click="BtnPlay_Click" Width="104" Height="44" Margin="0,0,8,0" Background="{StaticResource GreenGrad}" Foreground="White" FontSize="14" FontWeight="Bold" Effect="{StaticResource GlowGreen}"/>
                        <Button Content="⏸ Pause" Click="BtnPause_Click" Width="100" Height="44" Margin="0,0,8,0" Background="{StaticResource BlueGrad}" Foreground="White"/>
                        <Button Content="⏹ Stop" Click="BtnStop_Click" Width="100" Height="44" Background="{StaticResource RedGrad}" Foreground="White"/>
                        <Button x:Name="SetABtn" Content="Set A" Click="BtnSetA_Click" Width="80" Height="44" Margin="16,0,0,0" Background="{StaticResource DarkGrad}" Foreground="White"/>
                        <Button x:Name="SetBBtn" Content="Set B" Click="BtnSetB_Click" Width="80" Height="44" Margin="8,0,0,0" Background="{StaticResource DarkGrad}" Foreground="White"/>
                        <Button x:Name="LoopToggleBtn" Content="🔁 Loop" Click="BtnLoopToggle_Click" Width="100" Height="44" Margin="8,0,0,0" Background="{StaticResource DarkGrad}" Foreground="White"/>
                        <Button Content="🎚️ Mixer" Click="BtnMixer_Click" Width="100" Height="44" Margin="8,0,0,0" Background="{StaticResource DarkGrad}" Foreground="White"/>
                        <Button Content="💾 Export" Click="BtnExportAudio_Click" Width="100" Height="44" Margin="8,0,0,0" Background="{StaticResource DarkGrad}" Foreground="White"/>
                        <Button Content="📺 Output" Click="BtnOutput_Click" Width="100" Height="44" Margin="8,0,0,0" Background="{StaticResource DarkGrad}" Foreground="White"/>
                        <Button Content="🎧 DJ" Click="BtnDj_Click" Width="100" Height="44" Margin="8,0,0,0" Background="{StaticResource VioletGrad}" Foreground="White" FontWeight="Bold" Effect="{StaticResource GlowViolet}"/>
                        <Separator Width="1" Background="#2A3446" Margin="5,0"/>
                        <Button x:Name="BtnMasterMute" Content="🔊" Click="BtnMute_Click" Width="50" Height="44" Background="{StaticResource DarkGrad}" Foreground="#A0A5B5"/>
                        <TextBlock Text="Master" Foreground="#A0A5B5" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"/>
                        <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="1" Value="0.8" Width="120" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumePercent" Text="80%" Foreground="#A0A5B5" VerticalAlignment="Center" Width="40" FontSize="11" TextAlignment="Right"/>
                        <TextBlock x:Name="TimeDisplay" Text="0:00 / 0:00" Foreground="#69F0AE" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="15" FontWeight="Bold" FontFamily="Consolas" Effect="{StaticResource GlowText}"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
