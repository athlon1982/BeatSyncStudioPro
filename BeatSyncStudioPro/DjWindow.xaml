<Window x:Class="BeatSyncStudioPro.DjWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BeatSyncStudioPro"
        Title="DJ Decks — BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="1180" Height="920" MinWidth="1000" MinHeight="720"
        Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E14" Offset="0"/>
            <GradientStop Color="#131926" Offset="0.55"/>
            <GradientStop Color="#0D1420" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <LinearGradientBrush x:Key="HwPanelBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#171B26" Offset="0"/>
            <GradientStop Color="#0D1017" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="HwButton" TargetType="Button">
            <Setter Property="Background" Value="#2A303C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#454E63" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="8,8,0,0" Height="9" VerticalAlignment="Top" Background="#14FFFFFF"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7C8DB0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HwSliderH" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="8" CornerRadius="4" Background="#0A0C11" BorderBrush="#333A4C" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="34" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#2E3444" BorderBrush="#5A6280" BorderThickness="1">
                                                    <Border Height="3" Background="#E8ECF5" VerticalAlignment="Center" Margin="3,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HwToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="42" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="12" Background="#14161D" BorderBrush="#454E63" BorderThickness="1"/>
                                <Ellipse x:Name="Nub" Width="17" Height="17" Fill="#606A82" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#14532D"/>
                                <Setter TargetName="Nub" Property="Fill" Value="#1DB954"/>
                                <Setter TargetName="Nub" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Nub" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="DeckHostA" Grid.Column="0" Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="12" BorderBrush="#1DB954" BorderThickness="2"/>
        <Border x:Name="DeckHostB" Grid.Column="2" Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="12" BorderBrush="#B388FF" BorderThickness="2"/>

        <!-- Center mixer -->
        <Border Grid.Column="1" Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="12" Margin="10,0" BorderBrush="#2A3446" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🎧 MIXER" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Crossfader" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center"/>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="A" Foreground="#1DB954" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock Text="B" Foreground="#B388FF" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="XfadeSlider" Minimum="0" Maximum="1000" Value="500" Margin="0,2,0,4" Style="{StaticResource HwSliderH}"/>
                <TextBlock Text="Curve" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                <ComboBox x:Name="CurvePicker" SelectedIndex="1" HorizontalAlignment="Center" Width="150">
                    <ComboBoxItem Content="Smooth"/>
                    <ComboBoxItem Content="Constant Power"/>
                    <ComboBoxItem Content="Cut"/>
                </ComboBox>
                <TextBlock Text="Master" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <local:KnobControl x:Name="DjMasterKnob" Minimum="0" Maximum="1.25" Value="0.9" Width="96" Height="96" HorizontalAlignment="Center" Accent="#1DB954"/>
                <Button x:Name="RecordButton" Content="🔴 Record Mix" Click="RecordButton_Click" Height="38" Style="{StaticResource HwButton}" Margin="0,16,0,0"
                        Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="CruiseButton" Content="\U0001F6A2 CRUISE: OFF" Click="CruiseButton_Click" Height="34" Style="{StaticResource HwButton}" Margin="0,14,0,0"
                        Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="Cruise fade" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                <ComboBox x:Name="CruiseFadePicker" SelectedIndex="2" HorizontalAlignment="Center" Width="150">
                    <ComboBoxItem Content="2 seconds"/>
                    <ComboBoxItem Content="4 seconds"/>
                    <ComboBoxItem Content="8 seconds"/>
                    <ComboBoxItem Content="12 seconds"/>
                </ComboBox>
                <TextBlock Text="\U0001F3A4 MIC" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                <ComboBox x:Name="MicDevicePicker" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                <Button x:Name="MicButton" Content="\U0001F3A4 MIC: OFF" Click="MicButton_Click" Height="32" Style="{StaticResource HwButton}"
                        Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Grid x:Name="MicMeterGrid" Margin="0,6,0,0">
                    <Border Background="#14171E" Height="8" CornerRadius="4"/>
                    <Border x:Name="MicMeterFill" Background="#1DB954" Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <TextBlock Text="Mic level" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                <local:KnobControl x:Name="MicLevelKnob" Minimum="0" Maximum="1.5" Value="0.9" Width="64" Height="64" HorizontalAlignment="Center" Accent="#1DB954"/>
                <CheckBox x:Name="MicDuckBox" Content="Duck music while talking" IsChecked="True" FontSize="11" Margin="0,6,0,0" Style="{StaticResource HwToggle}"/>
                <Button x:Name="MicFxButton" Content="\U0001F39B\uFE0F Mic FX (EQ / Reverb)" Click="MicFxButton_Click" Height="28" Style="{StaticResource HwButton}" Margin="0,6,0,0"
                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="CompanionButton" Content="\U0001F4F1 Phone Companion" Click="CompanionButton_Click" Height="28" Style="{StaticResource HwButton}" Margin="0,6,0,0"
                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <TextBlock x:Name="DjStatus" Text="Load a song on each deck and mix." Foreground="#A0A5B5" FontSize="11"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Tip: SYNC matches Deck B to A (or A to B). Loops and hot cues need the BPM — type it or TAP it." Foreground="#666666" FontSize="10"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <!-- Splash-style green EQ strip -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,26,0,0" Height="30">
                    <Border Width="8" Height="10" Background="#1DB954" Opacity="0.75" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="18" Background="#1DB954" Opacity="0.85" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="26" Background="#1DB954" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="14" Background="#1DB954" Opacity="0.8" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="22" Background="#1DB954" Opacity="0.9" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="8" Background="#1DB954" Opacity="0.7" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="20" Background="#1DB954" Opacity="0.85" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="28" Background="#1DB954" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="12" Background="#1DB954" Opacity="0.75" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="24" Background="#1DB954" Opacity="0.9" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="16" Background="#1DB954" Opacity="0.8" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="9" Background="#1DB954" Opacity="0.7" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="21" Background="#1DB954" Opacity="0.85" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="13" Background="#1DB954" Opacity="0.75" Margin="1,0" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Sampler strip (v3.27) -->
    <Border Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="12" Margin="10,0,10,10" BorderBrush="#2A3446" BorderThickness="1">
        <StackPanel>
            <Grid>
                <TextBlock Text="&#x1F39A;&#xFE0F; SAMPLER" FontSize="13" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Sampler volume" Foreground="#A0A5B5" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <local:KnobControl x:Name="SamplerVolumeKnob" Minimum="0" Maximum="1.25" Value="0.9" Width="54" Height="54" VerticalAlignment="Center" Accent="#1DB954"/>
                </StackPanel>
            </Grid>
            <UniformGrid x:Name="SamplerPadGrid" Columns="8" Margin="0,6,0,0"/>
            <TextBlock Text="Click a pad to play it - right-click any pad to assign your own sound (WAV/MP3). Pad 1 is saved for your RAD-DAD! tag." Foreground="#666666" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
    </StackPanel>
    </ScrollViewer>
</Window>
