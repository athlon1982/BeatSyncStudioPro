<Window x:Class="BeatSyncStudioPro.DjWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BeatSyncStudioPro"
        Title="DJ Decks — BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="1816" Height="1032" MinWidth="900" MinHeight="560"
        Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E14" Offset="0"/>
            <GradientStop Color="#131926" Offset="0.55"/>
            <GradientStop Color="#0D1420" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <LinearGradientBrush x:Key="HwPanelBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#171B26" Offset="0"/>
            <GradientStop Color="#0D1017" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="HwButton" TargetType="Button">
            <Setter Property="Background" Value="#2A303C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#454E63" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="8,8,0,0" Height="9" VerticalAlignment="Top" Background="#14FFFFFF"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7C8DB0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HwSliderH" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="8" CornerRadius="4" Background="#0A0C11" BorderBrush="#333A4C" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <!-- v3.54 (audit #21): track clicks jump the value (drag still works too) -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="12" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="12" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="34" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#2E3444" BorderBrush="#5A6280" BorderThickness="1">
                                                    <Border Height="3" Background="#E8ECF5" VerticalAlignment="Center" Margin="3,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HwSliderV" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="8" CornerRadius="4" Background="#0A0C11" BorderBrush="#333A4C" BorderThickness="1" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <!-- v3.54 (audit #21): track clicks jump the value (drag still works too) -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Width="12" HorizontalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Width="12" HorizontalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="30" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#2E3444" BorderBrush="#5A6280" BorderThickness="1">
                                                    <Border Height="3" Background="#E8ECF5" VerticalAlignment="Center" Margin="3,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HwToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="42" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="12" Background="#14161D" BorderBrush="#454E63" BorderThickness="1"/>
                                <Ellipse x:Name="Nub" Width="17" Height="17" Fill="#606A82" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#14532D"/>
                                <Setter TargetName="Nub" Property="Fill" Value="#1DB954"/>
                                <Setter TargetName="Nub" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Nub" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- v3.40: the board is designed at 1800x1000 and the Viewbox scales it
         DOWN to fit smaller screens — everything is always on screen, the
         window never scrolls. -->
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <Grid Width="1800" Height="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand strip with the live master spectrum -->
        <Border Grid.Row="0" Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="14,6" Margin="10,10,10,0" BorderBrush="#2A3446" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🎧 BEATSYNC STUDIO PRO" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="DJ BOARD" Foreground="#A0A5B5" FontSize="10"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="18,0" Background="#0B0D13" CornerRadius="8" BorderBrush="#2A3446" BorderThickness="1" Height="34" VerticalAlignment="Center" Cursor="Hand"
                        MouseLeftButtonDown="MasterSpectrum_Click"
                        ToolTip="Live spectrum of the whole mix (both decks + sampler + mic) — what the audience hears. Click to change the spectrum density (fat / normal / fine bars).">
                    <Image x:Name="MasterSpectrumImage" Stretch="Fill" Margin="6,3"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="● LIVE MIX" Foreground="#1DB954" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    <Button Content="🎹 MIDI" Click="MidiButton_Click" Margin="12,0,0,0" Padding="10,3"
                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="Set up a MIDI controller — decks, crossfader, channel faders and sampler pads on real hardware, with Learn for every control"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Decks + center mixer -->
        <Grid Grid.Row="1" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="352"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DeckHostA" Grid.Column="0" Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="12" BorderBrush="#1DB954" BorderThickness="2"/>
            <Border x:Name="DeckHostB" Grid.Column="2" Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="12" BorderBrush="#B388FF" BorderThickness="2"/>

            <!-- Center mixer -->
            <Border Grid.Column="1" Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="10" Margin="10,0" BorderBrush="#2A3446" BorderThickness="1">
                <!-- v3.69: this column outgrew its fixed space as buttons were added
                     (Mashup, Save Mashup, Stop Both, stems picker), and the bottom
                     controls, the whole MIC / duck block, were clipped off-screen.
                     It scrolls now, so nothing in this column can ever be pushed
                     off the board again. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="🎧 MIXER" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Master" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                    <local:KnobControl x:Name="DjMasterKnob" Minimum="0" Maximum="1.25" Value="0.9" DefaultValue="0.9" Width="48" Height="48" HorizontalAlignment="Center" Accent="#1DB954"
                                       ToolTip="Master volume: how loud the whole mix is. Drag up/down or scroll on it. Double-click resets it."/>
                    <Button x:Name="RecordButton" Content="🔴 Record Mix" Click="RecordButton_Click" Height="32" Style="{StaticResource HwButton}" Margin="0,10,0,0"
                            Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            ToolTip="Record your whole performance (both decks, sampler and mic) to a WAV file. Click again to stop and save."/>
                    <Button x:Name="MashupButton" Content="🎤 MASHUP A+B" Click="MashupButton_Click" Height="38" Style="{StaticResource HwButton}" Margin="0,8,0,0"
                            Background="#7C4DFF" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"
                            ToolTip="MASHUP A+B — the real remix recipe: load a track on each deck and press this. Deck A plays VOCALS ONLY, Deck B plays the BEAT ONLY (drums + bass + other), tempo- and key-synced, started together — no lyrics-over-lyrics mess. It detects any missing BPMs and splits the stems first if a song hasn't been split yet (first time takes a while, then it's cached)."/>
                    <Button x:Name="SaveMashupButton" Content="💾 Save Mashup" Click="SaveMashupButton_Click" Height="32" Style="{StaticResource HwButton}" Margin="0,6,0,0" IsEnabled="False"
                            Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            ToolTip="Every mashup is captured automatically while it plays. If it sounds good, press this and it's saved into the library under the Mash-ups category (silence at the start/end is trimmed). Starting a new mashup throws the old capture away."/>
                    <Button x:Name="StopBothButton" Content="⏹ Stop Both Decks" Click="StopBothButton_Click" Height="32" Style="{StaticResource HwButton}" Margin="0,6,0,0"
                            Background="#A12424" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            ToolTip="Stop BOTH decks at once and rewind them to their cue points — no more stabbing one stop button then the other. A mashup capture keeps what already played, so you can still save it afterwards."/>
                    <Button x:Name="SetRecordButton" Content="🎙 Record My Set" Click="SetRecordButton_Click" Height="32" Style="{StaticResource HwButton}" Margin="0,6,0,0"
                            Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            ToolTip="Record the whole SET in one click — no file dialog, no naming. The performance lands in Music\BeatSync Sets, and a timestamped tracklist (every song, when it came in, which deck) is written beside the WAV automatically."/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stems run on:" Foreground="#A0A5B5" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1" x:Name="StemComputePicker" SelectionChanged="StemComputePicker_SelectionChanged"
                                  ToolTip="What splits the stems (Mashup + Split Stems): Auto uses the GPU when this PC has a proper graphics card and the CPU otherwise — integrated Intel graphics stay on Auto/CPU, they're slower at this and share your RAM. GPU forces the graphics card; CPU forces the processor. Applies to the next split.">
                            <ComboBoxItem Content="Auto (recommended)"/>
                            <ComboBoxItem Content="GPU"/>
                            <ComboBoxItem Content="CPU"/>
                        </ComboBox>
                    </Grid>

                    <!-- Channel strips: gain + 3-band EQ knobs + fader per deck, VU columns between -->
                    <TextBlock Text="CHANNELS" Foreground="#A0A5B5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- CH A strip -->
                        <StackPanel Grid.Column="0" Width="78">
                            <TextBlock Text="CH A" Foreground="#1DB954" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <local:KnobControl x:Name="ChAGainKnob" Minimum="0" Maximum="1.25" Value="1" DefaultValue="1" Width="44" Height="44" HorizontalAlignment="Center" Accent="#1DB954"
                                                ToolTip="Deck A channel gain — the same volume as Deck A's own gain knob and this strip's fader. Double-click resets it."/>
                            <TextBlock Text="GAIN" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center"/>
                            <local:KnobControl x:Name="ChAHiKnob" Minimum="-24" Maximum="24" Value="0" DefaultValue="0" Width="34" Height="34" HorizontalAlignment="Center" Accent="#1DB954" Margin="0,4,0,0"
                                                ToolTip="Deck A treble (high EQ). Turn down to soften Deck A while you blend; it's the same EQ as Deck A's FX window."/>
                            <TextBlock Text="HI" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center"/>
                            <local:KnobControl x:Name="ChAMidKnob" Minimum="-24" Maximum="24" Value="0" DefaultValue="0" Width="34" Height="34" HorizontalAlignment="Center" Accent="#1DB954" Margin="0,4,0,0"
                                                ToolTip="Deck A midrange EQ — where most vocals and instruments live."/>
                            <TextBlock Text="MID" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center"/>
                            <local:KnobControl x:Name="ChALowKnob" Minimum="-24" Maximum="24" Value="0" DefaultValue="0" Width="34" Height="34" HorizontalAlignment="Center" Accent="#1DB954" Margin="0,4,0,0"
                                                ToolTip="Deck A bass (low EQ). Classic blend move: turn the incoming deck's LOW down so the two basslines don't fight, then swap at the drop."/>
                            <TextBlock Text="LOW" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center"/>
                            <Slider x:Name="ChAFader" Orientation="Vertical" Minimum="0" Maximum="1000" Value="800" Height="56" HorizontalAlignment="Center" Margin="0,6,0,0" Style="{StaticResource HwSliderV}"
                                    ToolTip="Deck A channel fader — ride this to bring Deck A in or out of the mix by hand."/>
                            <TextBlock Text="FADER" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <Button x:Name="ChAResetBtn" Content="↺ Reset" Height="22" FontSize="10" Style="{StaticResource HwButton}" Margin="0,6,0,0" Click="ChAReset_Click"
                                    ToolTip="Reset this whole channel strip: gain back to 1.0, EQ flat, fader back to unity. (You can also double-click any single knob to reset just that knob.)"/>
                        </StackPanel>
                        <!-- VU A -->
                        <Grid Grid.Column="1" Width="13" Height="248" Margin="5,18,2,0" VerticalAlignment="Top" ClipToBounds="True"
                              ToolTip="Deck A's live level. Green is healthy; pinned at the top means it's too hot — ease the gain down.">
                            <Border Background="#0A0C11" CornerRadius="4" BorderBrush="#333A4C" BorderThickness="1"/>
                            <Border x:Name="VuAFill" Background="#1DB954" CornerRadius="4" VerticalAlignment="Bottom" Height="0" Margin="1"/>
                        </Grid>
                        <!-- VU B -->
                        <Grid Grid.Column="2" Width="13" Height="248" Margin="2,18,5,0" VerticalAlignment="Top" ClipToBounds="True"
                              ToolTip="Deck B's live level. Green is healthy; pinned at the top means it's too hot — ease the gain down.">
                            <Border Background="#0A0C11" CornerRadius="4" BorderBrush="#333A4C" BorderThickness="1"/>
                            <Border x:Name="VuBFill" Background="#B388FF" CornerRadius="4" VerticalAlignment="Bottom" Height="0" Margin="1"/>
                        </Grid>
                        <!-- CH B strip -->
                        <StackPanel Grid.Column="3" Width="78">
                            <TextBlock Text="CH B" Foreground="#B388FF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <local:KnobControl x:Name="ChBGainKnob" Minimum="0" Maximum="1.25" Value="1" DefaultValue="1" Width="44" Height="44" HorizontalAlignment="Center" Accent="#B388FF"
                                                ToolTip="Deck B channel gain — the same volume as Deck B's own gain knob and this strip's fader. Double-click resets it."/>
                            <TextBlock Text="GAIN" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center"/>
                            <local:KnobControl x:Name="ChBHiKnob" Minimum="-24" Maximum="24" Value="0" DefaultValue="0" Width="34" Height="34" HorizontalAlignment="Center" Accent="#B388FF" Margin="0,4,0,0"
                                                ToolTip="Deck B treble (high EQ). Turn down to soften Deck B while you blend; it's the same EQ as Deck B's FX window."/>
                            <TextBlock Text="HI" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center"/>
                            <local:KnobControl x:Name="ChBMidKnob" Minimum="-24" Maximum="24" Value="0" DefaultValue="0" Width="34" Height="34" HorizontalAlignment="Center" Accent="#B388FF" Margin="0,4,0,0"
                                                ToolTip="Deck B midrange EQ — where most vocals and instruments live."/>
                            <TextBlock Text="MID" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center"/>
                            <local:KnobControl x:Name="ChBLowKnob" Minimum="-24" Maximum="24" Value="0" DefaultValue="0" Width="34" Height="34" HorizontalAlignment="Center" Accent="#B388FF" Margin="0,4,0,0"
                                                ToolTip="Deck B bass (low EQ). Classic blend move: turn the incoming deck's LOW down so the two basslines don't fight, then swap at the drop."/>
                            <TextBlock Text="LOW" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center"/>
                            <Slider x:Name="ChBFader" Orientation="Vertical" Minimum="0" Maximum="1000" Value="800" Height="56" HorizontalAlignment="Center" Margin="0,6,0,0" Style="{StaticResource HwSliderV}"
                                    ToolTip="Deck B channel fader — ride this to bring Deck B in or out of the mix by hand."/>
                            <TextBlock Text="FADER" Foreground="#A0A5B5" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <Button x:Name="ChBResetBtn" Content="↺ Reset" Height="22" FontSize="10" Style="{StaticResource HwButton}" Margin="0,6,0,0" Click="ChBReset_Click"
                                    ToolTip="Reset this whole channel strip: gain back to 1.0, EQ flat, fader back to unity. (You can also double-click any single knob to reset just that knob.)"/>
                        </StackPanel>
                    </Grid>

                    <!-- Lower half (v3.42): stacked full-width so nothing clips -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Crossfader" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center"/>
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="A" Foreground="#1DB954" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock Text="B" Foreground="#B388FF" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="XfadeSlider" Minimum="0" Maximum="1000" Value="500" Margin="0,2,0,2" Style="{StaticResource HwSliderH}"
                                ToolTip="Crossfader: left = only Deck A plays, right = only Deck B, middle = both. This is how you blend from one song into the other."/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Curve" Foreground="#A0A5B5" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" x:Name="CurvePicker" SelectedIndex="1" Margin="0,0,10,0"
                                      ToolTip="Crossfader curve: Smooth fades gently, Constant Power keeps the volume even through the middle (best for blending), Cut snaps hard from one deck to the other (for scratch DJs).">
                                <ComboBoxItem Content="Smooth"/>
                                <ComboBoxItem Content="Constant Power"/>
                                <ComboBoxItem Content="Cut"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Fade" Foreground="#A0A5B5" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="3" x:Name="CruiseFadePicker" SelectedIndex="2"
                                      ToolTip="How long each Cruise crossfade lasts.">
                                <ComboBoxItem Content="2 seconds"/>
                                <ComboBoxItem Content="4 seconds"/>
                                <ComboBoxItem Content="8 seconds"/>
                                <ComboBoxItem Content="12 seconds"/>
                            </ComboBox>
                        </Grid>
                        <Button x:Name="CruiseButton" Content="&#x1F6A2; CRUISE: OFF" Click="CruiseButton_Click" Height="32" Style="{StaticResource HwButton}" Margin="0,8,0,0"
                                Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                ToolTip="Cruise (auto-DJ): plays through both decks' track lists by itself, crossfading at the end of each song. Load the track lists, set the fade time, and let it drive."/>
                        <TextBlock Text="&#x1F3A4; MIC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <ComboBox x:Name="MicDevicePicker" Margin="0,0,0,4"
                                  ToolTip="Which microphone to use. Pick it before going live."/>
                        <Button x:Name="MicButton" Content="&#x1F3A4; MIC: OFF" Click="MicButton_Click" Height="32" Style="{StaticResource HwButton}"
                                Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                ToolTip="Turn the live microphone on or off. When it's live, your voice goes out over the mix (and into Record Mix)."/>
                        <Grid x:Name="MicMeterGrid" Margin="0,6,0,0" ToolTip="Your microphone level while you talk.">
                            <Border Background="#14171E" Height="8" CornerRadius="4"/>
                            <Border x:Name="MicMeterFill" Background="#1DB954" Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Mic level" Foreground="#A0A5B5" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <local:KnobControl x:Name="MicLevelKnob" Minimum="0" Maximum="1.5" Value="0.9" DefaultValue="0.9" Width="44" Height="44" Accent="#1DB954"
                                                    ToolTip="Microphone volume in the mix. Drag up/down or scroll on it. Double-click resets it."/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="MicDuckBox" Content="Duck music while talking" IsChecked="True" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource HwToggle}"
                                      ToolTip="Ducking: while you talk into the mic, the music automatically dips down so your voice stays on top, then comes back up when you stop."/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Duck depth" Foreground="#A0A5B5" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" x:Name="MicDuckDepthPicker" SelectedIndex="1"
                                      ToolTip="How far the music drops while you talk. Radio is the normal broadcast balance.">
                                <ComboBoxItem Content="Light — 50%"/>
                                <ComboBoxItem Content="Radio — 30%"/>
                                <ComboBoxItem Content="Deep — 15%"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" x:Name="MicDuckState" Text="AUTO-DUCK OFF" Foreground="#59637A" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MicFxButton" Grid.Column="0" Content="&#x1F39B;&#xFE0F; Mic FX" Click="MicFxButton_Click" Height="32" Style="{StaticResource HwButton}" Margin="0,0,4,0"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Microphone effects: EQ and reverb for your voice."/>
                            <Button x:Name="CompanionButton" Grid.Column="1" Content="&#x1F4F1; Companion" Click="CompanionButton_Click" Height="32" Style="{StaticResource HwButton}" Margin="4,0,0,0"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Phone Companion: control the decks from your phone over Wi-Fi or Tailscale (play/cue, crossfader, sampler, cruise, mic). Opens the companion settings and start/stop window."/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Button x:Name="RequestsButton" Content="&#x1F4E8; Requests" Click="RequestsButton_Click" Height="32" Style="{StaticResource HwButton}"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Listener requests from the Rad-Dad Radio request page. While the Companion server runs, listeners open the request page at this PC's address, port 8765, /request. The button shows how many are waiting."/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Button x:Name="StreamButton" Content="&#x1F534; Go Live" Click="StreamButton_Click" Height="32" Style="{StaticResource HwButton}"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Go Live: stream the Output (visuals) window and the DJ mix to YouTube, Facebook, TikTok, or any RTMP address. Paste your stream key once — it stays encrypted on this PC."/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Button x:Name="OverlayButton" Content="&#x1F4FA; Stream Overlay: ON" Click="OverlayButton_Click" Height="32" Style="{StaticResource HwButton}"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Stream overlay: a Now Playing card on the Output window — current song, Rad-Dad Radio listener count, and the latest listener request. It is part of the picture your stream sends out."/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Button x:Name="DropsButton" Content="&#x1F4FB; Radio Drops" Click="DropsButton_Click" Height="32" Style="{StaticResource HwButton}"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Radio Drops: a board of big pads for station IDs, tags and promos. Assign any sound to a pad (right-click it in the board) — it plays over the mix and the music dips under it automatically."/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Button x:Name="EventButton" Content="&#x1F389; Event Mode" Click="EventButton_Click" Height="32" Style="{StaticResource HwButton}"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Event Mode: a big-button screen for live events — Now Playing, giant Play/Pause and Next Song, crossfader jumps, a giant mic switch and the radio drops. Nothing else to hit by mistake in the dark."/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Button x:Name="RadioButton" Content="&#x1F4E1; Internet Radio" Click="RadioButton_Click" Height="32" Style="{StaticResource HwButton}"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Internet Radio: listen to live online stations through the DJ mix — Rock 94.5 and Z97.1 from Rutland are built in, plus your own Rad-Dad Radio. Add any station with a direct stream address."/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="DjStatus" Text="Load a song on each deck and mix." Foreground="#A0A5B5" FontSize="11"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Tip: SYNC matches Deck B to A (or A to B). Loops and hot cues need the BPM — type it or TAP it. Hover any control to see what it does." Foreground="#666666" FontSize="10"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Sampler strip -->
        <Border Grid.Row="2" Background="{StaticResource HwPanelBg}" CornerRadius="12" Padding="12" Margin="10,0,10,10" BorderBrush="#2A3446" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <TextBlock Text="&#x1F39A;&#xFE0F; SAMPLER" FontSize="13" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Sampler volume" Foreground="#A0A5B5" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <local:KnobControl x:Name="SamplerVolumeKnob" Minimum="0" Maximum="1.25" Value="0.9" DefaultValue="0.9" Width="48" Height="48" VerticalAlignment="Center" Accent="#1DB954"
                                            ToolTip="How loud the sampler pads are in the mix. Drag up/down or scroll on it. Double-click resets it."/>
                    </StackPanel>
                </Grid>
                <UniformGrid x:Name="SamplerPadGrid" Columns="8" Margin="0,6,0,0"/>
                <TextBlock Text="Click a pad to play it — right-click any pad to assign a sound, rename it, or clear it. Every pad is yours to program." Foreground="#666666" FontSize="10" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </Viewbox>
</Window>
