<Window x:Class="BeatSyncStudioPro.DjWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Decks — BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="1240" Height="800" MinWidth="1020" MinHeight="720"
        Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0E14" Offset="0"/>
            <GradientStop Color="#131926" Offset="0.55"/>
            <GradientStop Color="#0D1420" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="DeckHostA" Grid.Column="0" Background="#12161F" CornerRadius="10" Padding="12" BorderBrush="#1DB954" BorderThickness="2"/>
        <Border x:Name="DeckHostB" Grid.Column="2" Background="#12161F" CornerRadius="10" Padding="12" BorderBrush="#B388FF" BorderThickness="2"/>

        <!-- Center mixer -->
        <Border Grid.Column="1" Background="#12161F" CornerRadius="10" Padding="12" Margin="10,0" BorderBrush="#2A3446" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🎧 MIXER" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Crossfader" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center"/>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="A" Foreground="#1DB954" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock Text="B" Foreground="#B388FF" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="XfadeSlider" Minimum="0" Maximum="1000" Value="500" Margin="0,2,0,4"/>
                <TextBlock Text="Curve" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                <ComboBox x:Name="CurvePicker" SelectedIndex="1" HorizontalAlignment="Center" Width="150">
                    <ComboBoxItem Content="Smooth"/>
                    <ComboBoxItem Content="Constant Power"/>
                    <ComboBoxItem Content="Cut"/>
                </ComboBox>
                <TextBlock Text="Master" Foreground="#A0A5B5" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <Slider x:Name="DjMasterSlider" Minimum="0" Maximum="1.25" Value="0.9"/>
                <Button x:Name="RecordButton" Content="🔴 Record Mix" Click="RecordButton_Click" Height="38" Margin="0,16,0,0"
                        Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <TextBlock x:Name="DjStatus" Text="Load a song on each deck and mix." Foreground="#A0A5B5" FontSize="11"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Tip: SYNC matches Deck B to A (or A to B). Loops and hot cues need the BPM — type it or TAP it." Foreground="#666666" FontSize="10"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <!-- Splash-style green EQ strip -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,26,0,0" Height="30">
                    <Border Width="8" Height="10" Background="#1DB954" Opacity="0.75" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="18" Background="#1DB954" Opacity="0.85" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="26" Background="#1DB954" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="14" Background="#1DB954" Opacity="0.8" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="22" Background="#1DB954" Opacity="0.9" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="8" Background="#1DB954" Opacity="0.7" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="20" Background="#1DB954" Opacity="0.85" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="28" Background="#1DB954" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="12" Background="#1DB954" Opacity="0.75" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="24" Background="#1DB954" Opacity="0.9" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="16" Background="#1DB954" Opacity="0.8" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="9" Background="#1DB954" Opacity="0.7" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="21" Background="#1DB954" Opacity="0.85" Margin="1,0" VerticalAlignment="Bottom"/>
                    <Border Width="8" Height="13" Background="#1DB954" Opacity="0.75" Margin="1,0" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
