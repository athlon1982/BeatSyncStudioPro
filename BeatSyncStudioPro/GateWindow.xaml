<Window x:Class="BeatSyncStudioPro.GateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noise Gate" Icon="/Assets/app.ico"
        Width="400" Height="250" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="🔇 Noise Gate" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="Silences everything quieter than the threshold — cleans up hiss, room noise and bleed between phrases."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"/>
        <CheckBox x:Name="EnabledCheck" Content="Gate on" Foreground="White"/>
        <Grid Margin="0,14,0,0">
            <TextBlock Text="Threshold" FontWeight="Bold"/>
            <TextBlock x:Name="ValueLabel" Text="-45 dB" HorizontalAlignment="Right" Foreground="#A0A5B5" FontSize="11"/>
        </Grid>
        <Slider x:Name="ThresholdSlider" Minimum="-70" Maximum="-20" Value="-45" Margin="0,4,0,0"/>
        <TextBlock Text="Lower (more negative) = only the quietest noise is cut. Too high will chop soft words."
                   Foreground="#666666" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="84" Height="32" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Apply" Click="Ok_Click" Width="84" Height="32" Margin="8,0,0,0" Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
