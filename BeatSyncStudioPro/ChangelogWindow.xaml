<Window x:Class="BeatSyncStudioPro.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changelog — BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="720" Height="640" MinWidth="520" MinHeight="400"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="📋 Changelog" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="What's new, improved, and fixed in every version — newest first."
                       Foreground="#A0A5B5" FontSize="12" Margin="0,4,0,10"/>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#2A3446" BorderThickness="1" CornerRadius="8" Background="#141920">
            <FlowDocumentScrollViewer x:Name="DocViewer" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>
