<Window x:Class="BeatSyncStudioPro.TagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Tags — BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="580" Height="372" WindowStartupLocation="CenterOwner"
        Background="#14171E" Foreground="#FFFFFF" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Width="240" Height="240" VerticalAlignment="Top"
                Background="#1B212E" BorderBrush="#2A3446" BorderThickness="1" CornerRadius="6" Margin="0,0,16,0">
            <Grid>
                <TextBlock x:Name="NoCoverText" Text="🎵&#x0a;No cover art&#x0a;in this file"
                           Foreground="#8A93A6" FontSize="14" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <StackPanel Grid.Column="1" Grid.Row="0" x:Name="RowsPanel"/>
        <Button Grid.Column="1" Grid.Row="1" Content="Close" Width="90" HorizontalAlignment="Right"
                Click="Close_Click" Margin="0,12,0,0"/>
    </Grid>
</Window>
