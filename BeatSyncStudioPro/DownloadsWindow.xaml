<Window x:Class="BeatSyncStudioPro.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads" Icon="/Assets/app.ico"
        Width="560" Height="430" MinWidth="440" MinHeight="280"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="⬇ Downloads" FontSize="16" FontWeight="Bold"/>
            <Button Content="Clear finished" Click="Clear_Click" HorizontalAlignment="Right" Padding="10,4"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <ListBox x:Name="ItemsList" Grid.Row="1" Margin="0,10,0,0" Background="#14171E" BorderBrush="#333"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#A0A5B5" Margin="10,0,0,0"/>
                        <Button Grid.Column="2" Content="⏸" Width="30" Margin="8,0,0,0" Tag="{Binding}" Click="Pause_Click"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Pause / resume"/>
                        <Button Grid.Column="3" Content="✖" Width="30" Margin="4,0,0,0" Tag="{Binding}" Click="Cancel_Click"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Cancel"/>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Height="8" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding Percent}" Foreground="#1DB954" Background="#232936" BorderThickness="0"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding Detail}" Foreground="#A0A5B5" FontSize="11" Margin="0,3,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#666666" FontSize="10" TextWrapping="Wrap"
                   Text="⏸ pauses a download (the same button resumes it). Pausing holds the connection open — a very long pause can make a server drop it; then just cancel and start it again."/>
    </Grid>
</Window>
