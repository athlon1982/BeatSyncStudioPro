<Window x:Class="BeatSyncStudioPro.NudgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nudge Audio" Icon="/Assets/app.ico"
        Width="360" Height="230" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="⏱️ Nudge this clip's audio" FontSize="14" FontWeight="Bold"/>
        <TextBlock Text="Shift the sound earlier or later without moving the clip — the fix for lip-sync that's a hair off. Negative = earlier, positive = later."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="-100" Click="Adjust_Click" Tag="-100" Width="52" Height="28" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="-10" Click="Adjust_Click" Tag="-10" Width="52" Height="28" Margin="4,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <TextBox x:Name="MsBox" Width="76" Height="28" Margin="8,0" TextAlignment="Center" Background="#14171E" Foreground="White" BorderBrush="#333" VerticalContentAlignment="Center"/>
            <Button Content="+10" Click="Adjust_Click" Tag="10" Width="52" Height="28" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="+100" Click="Adjust_Click" Tag="100" Width="52" Height="28" Margin="4,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
        <TextBlock Text="milliseconds" Foreground="#A0A5B5" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="80" Height="30" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Apply" Click="Ok_Click" Width="80" Height="30" Margin="8,0,0,0" Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
