<Window x:Class="BeatSyncStudioPro.SongLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Song Library" Icon="/Assets/app.ico"
        Width="1020" Height="640" MinWidth="760" MinHeight="460"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="🎵 Song Library" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="CountText" Margin="10,3,0,0" Foreground="#A0A5B5" FontSize="11"/>
        </StackPanel>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A0A5B5" FontSize="11"
                   Text="Full songs with their ID tags — separate from the short-sounds library. Built for remixing."/>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="📁 Add Folder…" Click="AddFolder_Click" Padding="12,6"
                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="Scan a folder (and everything inside it) for songs — MP3, FLAC, WAV, OGG, M4A — and read their ID tags"/>
                <Button Content="🗜️ Add ZIP…" Click="AddZip_Click" Margin="8,0,0,0" Padding="12,6"
                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="Pull the songs out of a ZIP file into the library"/>
                <Button Content="🎶 Add Files…" Click="AddFiles_Click" Margin="8,0,0,0" Padding="12,6"
                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="Add individual song files"/>
                <Button Content="🔍 Analyze BPM + Key" Click="Analyze_Click" Margin="16,0,0,0" Padding="12,6"
                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="For the selected songs (or every song missing them): detect BPM and musical key with the same detectors the DJ decks use, for songs whose tags don't carry them"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="#A0A5B5" FontSize="11" Margin="0,0,6,0"/>
                <TextBox x:Name="FilterBox" Width="200" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"
                         TextChanged="FilterBox_TextChanged" ToolTip="Filter by title, artist, album, genre or file name"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="SongGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#14171E" Foreground="White" BorderBrush="#333" RowBackground="#14171E"
                          AlternatingRowBackground="#1A1E27" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A3446"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          SelectionChanged="SongGrid_SelectionChanged" MouseDoubleClick="SongGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" SortMemberPath="DisplayTitle" Width="*"/>
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="130"/>
                        <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="120"/>
                        <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="85"/>
                        <DataGridTextColumn Header="BPM" Binding="{Binding BpmText}" SortMemberPath="Bpm" Width="48"/>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="44"/>
                        <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" SortMemberPath="Seconds" Width="52"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="56"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="⬇ Load on Deck A" Click="LoadDeckA_Click" Padding="12,6"
                            Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            ToolTip="Load the selected song onto DJ Deck A (opens the DJ board if it isn't open). Double-clicking a song does this too."/>
                    <Button Content="⬇ Load on Deck B" Click="LoadDeckB_Click" Margin="8,0,0,0" Padding="12,6"
                            Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            ToolTip="Load the selected song onto DJ Deck B"/>
                    <Button Content="➕ A Track List" Click="QueueDeckA_Click" Margin="16,0,0,0" Padding="12,6"
                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="Add the selected song(s) to Deck A's track list without loading them yet"/>
                    <Button Content="➕ B Track List" Click="QueueDeckB_Click" Margin="8,0,0,0" Padding="12,6"
                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="Add the selected song(s) to Deck B's track list without loading them yet"/>
                    <Button Content="🗑 Remove" Click="Remove_Click" Margin="16,0,0,0" Padding="12,6"
                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="Remove the selected song(s) from the library list. The files themselves are never deleted."/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Margin="12,0,0,0" Background="#14171E" BorderBrush="#2A3446" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <Grid Height="200">
                        <Image x:Name="CoverImage" Stretch="Uniform" Visibility="Collapsed"/>
                        <TextBlock x:Name="NoCoverText" Text="🎵" FontSize="64" Foreground="#2A3446"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="DTitle" Margin="0,10,0,0" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Text="Pick a song"/>
                    <TextBlock x:Name="DArtist" Foreground="#A0A5B5" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DAlbum" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DLine" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="DMix" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock x:Name="DPath" Foreground="#5B6172" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"
                   Text="Add a folder, a ZIP, or some files — every song's ID tags are read automatically, and the list sorts by any column (click a header)."/>
    </Grid>
</Window>
