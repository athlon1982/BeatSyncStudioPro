<Window x:Class="BeatSyncStudioPro.SongLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Song Library" Icon="/Assets/app.ico"
        Width="1020" Height="660" MinWidth="760" MinHeight="480"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="🎵 Song Library" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="CountText" Margin="10,3,0,0" Foreground="#A0A5B5" FontSize="11"/>
        </StackPanel>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A0A5B5" FontSize="11"
                   Text="Your songs, sorted by their tags — built for remixing."/>

        <TabControl x:Name="LibTabs" Grid.Row="1" Margin="0,10,0,0" Background="#1E222B" BorderBrush="#2A3446"
                    SelectionChanged="LibTabs_SelectionChanged">

            <TabItem Header="📁 Local Songs" Foreground="White">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="📁 Library folder:" VerticalAlignment="Center" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBlock x:Name="LibDirText" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="White" FontSize="11"
                                   ToolTip="BeatSync's own music library: every song you add — from search, files, folders, ZIPs — lands in this folder, and the track list below is the list of everything in the library."/>
                        <Button Content="Change…" Click="ChangeDir_Click" Margin="10,0,0,0" Padding="10,4"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                ToolTip="Pick a different folder for the library. Songs already added stay where they are; new songs go to the new folder."/>
                        <Button Content="📂 Open" Click="OpenDir_Click" Margin="6,0,0,0" Padding="10,4"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                ToolTip="Open the library folder in Explorer"/>
                        <CheckBox x:Name="CopyImportsBox" Content="Copy imports into the library folder" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Foreground="#A0A5B5" FontSize="11" Checked="CopyImports_Changed" Unchecked="CopyImports_Changed"
                                  ToolTip="When on, Add Folder / Add Files COPY the songs into the library folder so the library is self-contained. When off, songs are listed where they already live."/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📁 Add Folder…" Click="AddFolder_Click" Padding="12,6"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Scan a folder (and everything inside it) for songs — MP3, FLAC, WAV, OGG, M4A — and read their ID tags"/>
                            <Button Content="🗜️ Add ZIP…" Click="AddZip_Click" Margin="8,0,0,0" Padding="12,6"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Pull the songs out of a ZIP file into the library"/>
                            <Button Content="🎶 Add Files…" Click="AddFiles_Click" Margin="8,0,0,0" Padding="12,6"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Add individual song files"/>
                            <Button Content="🔍 Analyze BPM + Key" Click="Analyze_Click" Margin="16,0,0,0" Padding="12,6"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="For the selected songs (or every song missing them): detect BPM and musical key with the same detectors the DJ decks use, for songs whose tags don't carry them"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="#A0A5B5" FontSize="11" Margin="0,0,6,0"/>
                            <TextBox x:Name="FilterBox" Width="200" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"
                                     TextChanged="FilterBox_TextChanged" ToolTip="Filter by title, artist, album, genre or file name"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="SongGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#14171E" Foreground="White" BorderBrush="#333" RowBackground="#14171E"
                                      AlternatingRowBackground="#1A1E27" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A3446"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      SelectionChanged="SongGrid_SelectionChanged" MouseDoubleClick="SongGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" SortMemberPath="DisplayTitle" Width="*"/>
                                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="130"/>
                                    <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="120"/>
                                    <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="85"/>
                                    <DataGridTextColumn Header="BPM" Binding="{Binding BpmText}" SortMemberPath="Bpm" Width="48"/>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="44"/>
                                    <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" SortMemberPath="Seconds" Width="52"/>
                                    <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="56"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="⬇ Load on Deck A" Click="LoadDeckA_Click" Padding="12,6"
                                        Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Load the selected song onto DJ Deck A (opens the DJ board if it isn't open). Double-clicking a song does this too."/>
                                <Button Content="⬇ Load on Deck B" Click="LoadDeckB_Click" Margin="8,0,0,0" Padding="12,6"
                                        Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Load the selected song onto DJ Deck B"/>
                                <Button Content="➕ A Track List" Click="QueueDeckA_Click" Margin="16,0,0,0" Padding="12,6"
                                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Add the selected song(s) to Deck A's track list without loading them yet"/>
                                <Button Content="➕ B Track List" Click="QueueDeckB_Click" Margin="8,0,0,0" Padding="12,6"
                                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Add the selected song(s) to Deck B's track list without loading them yet"/>
                                <Button Content="🗑 Remove" Click="Remove_Click" Margin="16,0,0,0" Padding="12,6"
                                        Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Remove the selected song(s) from the library list. The files themselves are never deleted."/>
                                <Button Content="🗑 Delete File…" Click="DeleteFile_Click" Margin="8,0,0,0" Padding="12,6"
                                        Background="#5C2320" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Remove the selected song(s) from the library AND delete their files from the library folder. The app always asks you to confirm first — nothing is ever deleted without your OK."/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" Margin="12,0,0,0" Background="#14171E" BorderBrush="#2A3446" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <Grid Height="200">
                                    <Image x:Name="CoverImage" Stretch="Uniform" Visibility="Collapsed"/>
                                    <TextBlock x:Name="NoCoverText" Text="🎵" FontSize="64" Foreground="#2A3446"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="DTitle" Margin="0,10,0,0" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Text="Pick a song"/>
                                <TextBlock x:Name="DArtist" Foreground="#A0A5B5" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DAlbum" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DLine" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="DMix" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="DPath" Foreground="#5B6172" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="SunoTab" Header="☀️ Suno" Foreground="White">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔄 Sync My Suno Songs" Click="SyncSuno_Click" Padding="12,6"
                                    Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Read your Suno library from the signed-in browser below — published songs and drafts. Never uses Suno's Download action or your download quota."/>
                            <Button Content="🌐 Open Suno" Click="OpenSuno_Click" Margin="8,0,0,0" Padding="12,6"
                                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Show suno.com in the browser strip below — sign in there if you haven't yet (the same sign-in the My Songs window uses)"/>
                        </StackPanel>
                        <TextBlock x:Name="SunoCountText" Grid.Column="2" VerticalAlignment="Center" Foreground="#A0A5B5" FontSize="11"/>
                    </Grid>

                    <DataGrid x:Name="SunoGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#14171E" Foreground="White" BorderBrush="#333" RowBackground="#14171E"
                              AlternatingRowBackground="#1A1E27" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A3446"
                              SelectionMode="Single" SelectionUnit="FullRow" RowHeight="46"
                              MouseDoubleClick="SunoGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Cover" Width="54">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding DisplayCover}" Width="40" Height="40" Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" SortMemberPath="DisplayTitle" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                            <DataGridTextColumn Header="BPM" Binding="{Binding BpmText}" SortMemberPath="Bpm" Width="48"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="44"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" SortMemberPath="Seconds" Width="52"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="⬇ Stream to Deck A" Click="SunoDeckA_Click" Padding="12,6"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                ToolTip="Stream the selected song (the same stream Suno's web player plays — not a download) and load it onto DJ Deck A. Double-clicking a song does this too."/>
                        <Button Content="⬇ Stream to Deck B" Click="SunoDeckB_Click" Margin="8,0,0,0" Padding="12,6"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                ToolTip="Stream the selected song onto DJ Deck B"/>
                        <Button Content="🔍 Analyze BPM + Key" Click="SunoAnalyze_Click" Margin="16,0,0,0" Padding="12,6"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                ToolTip="Stream the selected song once and detect its BPM and key, so you can plan mixes before loading it"/>
                        <Button Content="🔗 Open on Suno" Click="SunoOpenPage_Click" Margin="8,0,0,0" Padding="12,6"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                ToolTip="Open the selected song's Suno page in your browser"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Margin="0,10,0,4" Foreground="#A0A5B5" FontSize="11"
                               Text="Suno browser — sign in here once; Sync reads your library from it. Streaming plays your songs, it never downloads them."/>
                    <Border Grid.Row="4" BorderBrush="#2A3446" BorderThickness="1">
                        <wv2:WebView2 x:Name="SunoBrowser"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="🎧 Spotify" Foreground="White">
                <StackPanel Margin="14" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Spotify playlists — track lists for planning" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Margin="0,10,0,0" Foreground="#A0A5B5" FontSize="12" TextWrapping="Wrap"
                               Text="Here's the honest deal with Spotify: no app is allowed to play Spotify's songs as audio through a DJ mixer — not this one, not the big-name DJ programs either. Spotify locks its audio to its own player. What IS possible: importing your playlists as track lists (names, artists, covers) so you can plan a set here, then play it in Spotify itself."/>
                    <TextBlock Margin="0,10,0,0" Foreground="#A0A5B5" FontSize="12" TextWrapping="Wrap"
                               Text="To switch that on, Spotify asks every app for its own (free) developer keys — the same idea as the Jamendo client ID. Your part takes about five minutes: sign in at developer.spotify.com, create an app, and you'll get a Client ID and Client Secret. Bring those back and the playlist import gets built into this tab, with the keys stored encrypted on this PC like the others."/>
                    <Button Content="🌐 Open Spotify Developer Dashboard" Click="SpotifyDev_Click" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,6"
                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"
                   Text="Add a folder, a ZIP, or some files — every song's ID tags are read automatically, and the list sorts by any column (click a header)."/>
    </Grid>
</Window>
