<Window x:Class="BeatSyncStudioPro.SpectrogramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spectrogram" Icon="/Assets/app.ico"
        Width="900" Height="430" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock x:Name="TitleText" Text="🌈 Spectrogram" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="Time runs left → right, pitch bottom → top (low at the bottom, high at the top). Bright = loud. Vocals show as wavy horizontal bands; hiss shows as a faint wash up high."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
        <Border BorderBrush="#333" BorderThickness="1" Background="Black">
            <Image x:Name="SpecImage" Width="864" Height="300" Stretch="Fill"/>
        </Border>
        <TextBlock x:Name="StatusText" Text="Computing…" Foreground="#A0A5B5" FontSize="11" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
