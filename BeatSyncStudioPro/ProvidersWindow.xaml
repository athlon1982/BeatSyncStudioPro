<Window x:Class="BeatSyncStudioPro.ProvidersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌐 Providers — BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="660" Height="740" MinWidth="520" MinHeight="480"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="🌐 Providers" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Connect your own paid APIs, or jump on the free ones. Every provider is labeled FREE or PAID so you always know before you sign up. Providers with a key box work inside BeatSync today; the rest are a directory — grab an account now and their in-app generation arrives as each client is added."
                       Foreground="#A0A5B5" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Cards" Margin="0,0,6,0"/>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Close" Click="Close_Click" HorizontalAlignment="Right" Padding="18,7" Margin="0,10,0,0"
                Background="#2A303C" Foreground="White" BorderBrush="#3D4454" Cursor="Hand"/>
    </Grid>
</Window>
