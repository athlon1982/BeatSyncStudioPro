<Window x:Class="BeatSyncStudioPro.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeatSync Studio Pro" Icon="/Assets/app.ico" Width="880" Height="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#0E1116"
        MouseLeftButtonDown="Splash_MouseLeftButtonDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Splash artwork -->
        <Image Grid.Row="0" x:Name="SplashArt" Stretch="UniformToFill"/>

        <!-- Title bar -->
        <Border Grid.Row="1" Background="#14171E" Padding="28,16">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="BeatSync Studio Pro" FontSize="34" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="MUSIC MIXING EDITOR" FontSize="13" FontWeight="SemiBold" Foreground="#1DB954"/>
                    <TextBlock Text="Created by Michael DeCato" FontSize="12" Foreground="#A0A5B5" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="Version 3.35" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                    <TextBlock Text="Loading the studio..." FontSize="11" Foreground="#666666" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" Height="3" IsIndeterminate="True"
                     Foreground="#1DB954" Background="Transparent" BorderThickness="0"/>
    </Grid>
</Window>
