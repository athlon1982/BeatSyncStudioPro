<Window x:Class="BeatSyncStudioPro.AiLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Lab — BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="780" Height="720" MinWidth="640" MinHeight="560"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Dark controls for the whole Lab (v3.19): the default Windows
             button/tab templates are light and looked washed-out/faded on
             this dark window — Michael called it out ("buttons are faded
             out in a lot of areas"). One template here fixes every button;
             disabled buttons now dim evenly instead of washing to grey. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A303C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D4454"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7C5CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A1E26"/>
            <Setter Property="Foreground" Value="#9AA0AE"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0"
                                BorderBrush="#2A303C" BorderThickness="1,1,1,0" Margin="2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A303C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#232833"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🤖 AI Lab" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Connect an AI and generate lyrics, titles, and beats. Your styles stay yours — the AI drafts, you decide."
                           Foreground="#A0A5B5" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="🌐 Providers…" Click="Providers_Click" VerticalAlignment="Top" Padding="14,7"
                    ToolTip="Connect your paid APIs and find the free ones — every provider labeled FREE or PAID, with signup and key links"/>
        </Grid>

        <TabControl x:Name="AiTabControl" Grid.Row="1" Background="#1E222B" BorderBrush="#2A3446">
            <TabItem Header="🎤 Song" Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Provider" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProviderPicker" Grid.Column="1" SelectionChanged="ProviderPicker_SelectionChanged"/>
                        <TextBlock Text="Model" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,8,0" Grid.Column="2"/>
                        <ComboBox x:Name="ModelPicker" Grid.Column="3" IsEditable="True"/>
                        <Button x:Name="RefreshBtn" Grid.Column="4" Content="🔄" Width="36" Margin="8,0,0,0" Click="RefreshBtn_Click"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Reload the model list"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Make" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ModePicker" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="🎤 Song Lyrics"/>
                            <ComboBoxItem Content="💡 Song Title Ideas"/>
                            <ComboBoxItem Content="🥁 A Beat From My Description"/>
                            <ComboBoxItem Content="💬 Free Chat"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="🎤 Create Song from this…" Click="CreateSongFromThis_Click" Margin="14,0,0,0" Padding="12,4"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                ToolTip="Open the Create Song panel with this text as the lyrics"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Topic / description / question" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBox x:Name="InputBox" Height="74" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="GenerateBtn" Content="✨ Generate" Click="Generate_Click" Height="36" Width="130"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="CancelBtn" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Height="36" Width="80" Margin="8,0,0,0"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
                        <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                        <CheckBox x:Name="CompareBox" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="#E2E8F0"
                                  Content="🔀 Compare all AIs — run this through every AI you've connected and compare the results side by side"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="Result (yours to edit)" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBox x:Name="OutputBox" Height="190" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                    </StackPanel>

                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📋 Copy Result" Click="Copy_Click" Padding="14,6" VerticalAlignment="Center"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Grid.Column="1" Text="Beats open straight in the step sequencer, ready to edit."
                                   Foreground="#666666" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <Button Grid.Column="2" Content="🎤 Make THIS into a Song →" Click="CreateSongFromThis_Click" Height="40" Padding="20,6"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                ToolTip="Take these lyrics into Create Song — pick the style, voice, sliders and an auto-made beat, then Generate Song"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="📖 Story to Lyrics" Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Turn a story or idea into full lyrics. Uses the provider &amp; model from the 🎤 Song tab. Your voice stays Rad-Dad boom-rap — genre and mood shape the story's feel." Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Genre" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="GenrePicker" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Boom-Rap (Rad-Dad style)"/>
                            <ComboBoxItem Content="Country Rap"/>
                            <ComboBoxItem Content="Americana / Indie Folk"/>
                            <ComboBoxItem Content="Hip-Hop"/>
                            <ComboBoxItem Content="Pop"/>
                            <ComboBoxItem Content="Rock"/>
                            <ComboBoxItem Content="Trap"/>
                            <ComboBoxItem Content="Lo-Fi"/>
                        </ComboBox>
                        <TextBlock Text="Mood" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,8,0" Grid.Column="2"/>
                        <ComboBox x:Name="MoodPicker" Grid.Column="3" SelectedIndex="0">
                            <ComboBoxItem Content="Nostalgic"/>
                            <ComboBoxItem Content="Happy"/>
                            <ComboBoxItem Content="Melancholic"/>
                            <ComboBoxItem Content="Hype"/>
                            <ComboBoxItem Content="Reflective"/>
                            <ComboBoxItem Content="Heartfelt"/>
                            <ComboBoxItem Content="Party"/>
                        </ComboBox>
                        <TextBlock Text="Structure" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,8,0" Grid.Column="4"/>
                        <ComboBox x:Name="StructurePicker" Grid.Column="5" SelectedIndex="0">
                            <ComboBoxItem Content="Verse-Chorus-Verse-Chorus-Bridge-Chorus-Outro"/>
                            <ComboBoxItem Content="Verse-Chorus-Verse-Chorus-Bridge-Chorus"/>
                            <ComboBoxItem Content="Verse-Chorus-Verse-Chorus"/>
                            <ComboBoxItem Content="Verse-Pre-Chorus-Chorus-Verse-Chorus"/>
                            <ComboBoxItem Content="AI decides"/>
                        </ComboBox>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Story / concept / idea" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBox x:Name="StoryBox" Height="74" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StoryGenerateBtn" Content="✨ Generate Song" Click="StoryGenerate_Click" Height="36" Width="150"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="StoryCancelBtn" Grid.Column="1" Content="Cancel" Click="StoryCancel_Click" Height="36" Width="80" Margin="8,0,0,0"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
                        <TextBlock x:Name="StoryStatusText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Lyrics (yours to edit)" Foreground="#A0A5B5" FontSize="11"/>
                            <TextBox x:Name="StoryLyricsBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Style suggestion" Foreground="#A0A5B5" FontSize="11"/>
                            <TextBox x:Name="StoryStyleBox" Height="80" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                            <TextBlock Text="Suggested titles" Foreground="#A0A5B5" FontSize="11" Margin="0,10,0,0"/>
                            <TextBox x:Name="StoryTitlesBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📋 Copy Lyrics" Click="StoryCopy_Click" Padding="14,6" VerticalAlignment="Center"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Grid.Column="1" Text="Lyrics carry your Rad-Dad voice — edit anything before it becomes a song."
                                   Foreground="#666666" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <Button Grid.Column="2" Content="🎤 Make THESE Lyrics into a Song →" Click="StoryMakeSong_Click" Height="40" Padding="20,6"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                ToolTip="Take these lyrics into Create Song — pick the style, voice, sliders and an auto-made beat, then Generate Song"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="✨ Lyrics Optimizer" Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Polish lyrics you already have. Uses the provider &amp; model from the 🎤 Song tab. Your voice stays Rad-Dad boom-rap — meta tags and vocal coaching shape the polish." Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Meta tags (style tags, e.g. melancholic piano, swelling strings, mid-tempo, 90 BPM)" Foreground="#A0A5B5" FontSize="11"/>
                            <TextBox x:Name="MetaTagsBox" Height="40" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Vocal coaching (delivery notes, e.g. clear male vocal, emotive, building intensity)" Foreground="#A0A5B5" FontSize="11"/>
                            <TextBox x:Name="VocalBox" Height="40" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Lyrics to polish" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBox x:Name="OptLyricsBox" Height="110" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OptGenerateBtn" Content="✨ Optimize Lyrics" Click="OptGenerate_Click" Height="36" Width="150"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="OptCancelBtn" Grid.Column="1" Content="Cancel" Click="OptCancel_Click" Height="36" Width="80" Margin="8,0,0,0"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
                        <TextBlock x:Name="OptStatusText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Optimized lyrics (yours to edit)" Foreground="#A0A5B5" FontSize="11"/>
                            <TextBox x:Name="OptOutLyricsBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Optimized style line" Foreground="#A0A5B5" FontSize="11"/>
                            <TextBox x:Name="OptStyleBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📋 Copy Optimized Lyrics" Click="OptCopy_Click" Padding="14,6" VerticalAlignment="Center"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Grid.Column="1" Text="The story and meaning stay yours — only the flow, rhyme and singability get tightened."
                                   Foreground="#666666" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <Button Grid.Column="2" Content="🎤 Make THESE Lyrics into a Song →" Click="OptMakeSong_Click" Height="40" Padding="20,6"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                ToolTip="Take these lyrics into Create Song — pick the style, voice, sliders and an auto-made beat, then Generate Song"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="🔄 Lyrics Rewriter" Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Give lyrics a fresh take — same idea, new words. Uses the provider &amp; model from the 🎤 Song tab. Your voice stays Rad-Dad boom-rap." Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rewrite goal" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RwGoalPicker" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Fresh take — same story, new words"/>
                            <ComboBoxItem Content="Different mood — same story"/>
                            <ComboBoxItem Content="Shorter and punchier"/>
                            <ComboBoxItem Content="Bigger chorus"/>
                            <ComboBoxItem Content="More Vermont country-rap edge"/>
                        </ComboBox>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Direction (optional — e.g. keep the truck line, make the chorus bigger)" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBox x:Name="RwDirectionBox" Height="40" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="Original lyrics" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBox x:Name="RwLyricsBox" Height="110" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RwGenerateBtn" Content="🔄 Rewrite Lyrics" Click="RwGenerate_Click" Height="36" Width="150"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="RwCancelBtn" Grid.Column="1" Content="Cancel" Click="RwCancel_Click" Height="36" Width="80" Margin="8,0,0,0"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
                        <TextBlock x:Name="RwStatusText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Rewritten lyrics (yours to edit)" Foreground="#A0A5B5" FontSize="11"/>
                            <TextBox x:Name="RwOutLyricsBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Style line" Foreground="#A0A5B5" FontSize="11"/>
                            <TextBox x:Name="RwStyleBox" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📋 Copy Rewritten Lyrics" Click="RwCopy_Click" Padding="14,6" VerticalAlignment="Center"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Grid.Column="1" Text="A rewrite is a new draft, not a polish — the Optimizer tab is the one that keeps your lines."
                                   Foreground="#666666" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0"/>
