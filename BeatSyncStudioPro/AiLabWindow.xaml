<Window x:Class="BeatSyncStudioPro.AiLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Lab — BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="780" Height="720" MinWidth="640" MinHeight="560"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Dark controls for the whole Lab (v3.19): the default Windows
             button/tab templates are light and looked washed-out/faded on
             this dark window — Michael called it out ("buttons are faded
             out in a lot of areas"). One template here fixes every button;
             disabled buttons now dim evenly instead of washing to grey. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A303C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D4454"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7C5CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A1E26"/>
            <Setter Property="Foreground" Value="#9AA0AE"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0"
                                BorderBrush="#2A303C" BorderThickness="1,1,1,0" Margin="2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A303C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#232833"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🤖 AI Lab" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Connect an AI and generate lyrics, titles, and beats. Your styles stay yours — the AI drafts, you decide."
                           Foreground="#A0A5B5" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="🌐 Providers…" Click="Providers_Click" VerticalAlignment="Top" Padding="14,7"
                    ToolTip="Connect your paid APIs and find the free ones — every provider labeled FREE or PAID, with signup and key links"/>
        </Grid>

        <TabControl Grid.Row="1" Background="#1E222B" BorderBrush="#2A3446">
            <TabItem Header="🎤 Song" Foreground="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Provider" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProviderPicker" Grid.Column="1" SelectionChanged="ProviderPicker_SelectionChanged"/>
                        <TextBlock Text="Model" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,8,0" Grid.Column="2"/>
                        <ComboBox x:Name="ModelPicker" Grid.Column="3" IsEditable="True"/>
                        <Button x:Name="RefreshBtn" Grid.Column="4" Content="🔄" Width="36" Margin="8,0,0,0" Click="RefreshBtn_Click"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Reload the model list"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Make" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ModePicker" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="🎤 Song Lyrics"/>
                            <ComboBoxItem Content="💡 Song Title Ideas"/>
                            <ComboBoxItem Content="🥁 A Beat From My Description"/>
                            <ComboBoxItem Content="💬 Free Chat"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="🎤 Create Song from this…" Click="CreateSongFromThis_Click" Margin="14,0,0,0" Padding="12,4"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                                ToolTip="Open the Create Song panel with this text as the lyrics"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Topic / description / question" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBox x:Name="InputBox" Height="74" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="GenerateBtn" Content="✨ Generate" Click="Generate_Click" Height="36" Width="130"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="CancelBtn" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Height="36" Width="80" Margin="8,0,0,0"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
                        <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                        <CheckBox x:Name="CompareBox" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="#E2E8F0"
                                  Content="🔀 Compare all AIs — run this through every AI you've connected and compare the results side by side"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="Result (yours to edit)" Foreground="#A0A5B5" FontSize="11"/>
                        <TextBox x:Name="OutputBox" Height="190" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="8"/>
                    </StackPanel>

                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📋 Copy Result" Click="Copy_Click" Padding="14,6" VerticalAlignment="Center"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Grid.Column="1" Text="Beats open straight in the step sequencer, ready to edit."
                                   Foreground="#666666" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <Button Grid.Column="2" Content="🎤 Make THIS into a Song →" Click="CreateSongFromThis_Click" Height="40" Padding="20,6"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                ToolTip="Take these lyrics into Create Song — pick the style, voice, sliders and an auto-made beat, then Generate Song"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="🎬 Video" Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,2,4,4">
                    <TextBlock Text="Describe a clip and an AI films it. Runs on fal.ai with the key from the Keys &amp; Compute tab (paid per clip — video is heavy, there's no free hosted tier that actually works yet; your home engine will be the free route once it's set up)."
                               Foreground="#8A90A0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Video prompt" FontWeight="SemiBold" Margin="0,2,0,3"/>
                    <TextBox x:Name="VideoPromptBox" Height="62" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="#12151C" Foreground="White" CaretBrush="White" BorderBrush="#2A303C" Padding="6,4"
                             ToolTip="e.g. A red pickup truck driving a Vermont dirt road at golden hour, dust kicking up, cinematic drone shot following behind"/>
                    <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,10,0,3"/>
                    <ComboBox x:Name="VideoModelBox" SelectedIndex="0" Background="#12151C" Foreground="White" BorderBrush="#2A303C">
                        <ComboBoxItem Content="MiniMax Video-01 — strong all-rounder (paid)" Tag="fal-ai/minimax/video-01"/>
                        <ComboBoxItem Content="Veo 3 — Google's best, video WITH sound (paid)" Tag="fal-ai/veo3"/>
                        <ComboBoxItem Content="Kling 2.1 Master — premium motion (paid)" Tag="fal-ai/kling-video/v2.1/master/text-to-video"/>
                        <ComboBoxItem Content="Kling 1.6 Standard — solid &amp; cheaper (paid)" Tag="fal-ai/kling-video/v1.6/standard/text-to-video"/>
                        <ComboBoxItem Content="Luma Ray 2 — Dream Machine (paid)" Tag="fal-ai/luma-dream-machine/ray-2"/>
                        <ComboBoxItem Content="Wan Pro — Alibaba's pro video (paid)" Tag="fal-ai/wan-pro/text-to-video"/>
                        <ComboBoxItem Content="PixVerse V4.5 (paid)" Tag="fal-ai/pixverse/v4.5/text-to-video"/>
                        <ComboBoxItem Content="Vidu Q1 (paid)" Tag="fal-ai/vidu/q1/text-to-video"/>
                        <ComboBoxItem Content="LTX-2 19B — fast &amp; cheaper (paid)" Tag="fal-ai/ltx-2-19b/text-to-video"/>
                        <ComboBoxItem Content="LTX-2.3 22B — newest LTX, higher quality (paid)" Tag="fal-ai/ltx-2.3-22b/text-to-video"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="VideoGenBtn" Content="🎬 Generate Video" Click="VideoGen_Click" Padding="16,8"
                                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <ProgressBar x:Name="VideoProg" IsIndeterminate="True" Width="130" Height="8" Margin="12,0,0,0"
                                     VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Text="Clips usually take 1–5 minutes." Foreground="#666666" FontSize="10"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Border Background="Black" BorderBrush="#2A303C" BorderThickness="1" Height="252" Margin="0,12,0,0">
                        <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      ScrubbingEnabled="True" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="▶ Play" Click="VideoPlay_Click" Padding="10,4" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="⏸ Pause" Click="VideoPause_Click" Padding="10,4" Margin="6,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="⏹ Stop" Click="VideoStop_Click" Padding="10,4" Margin="6,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="VideoAddBtn" Content="🎬 Add to my project" Click="VideoAdd_Click" Padding="12,4" Margin="16,0,0,0"
                                Background="#7C5CFF" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False"
                                ToolTip="Files the clip in your asset library under Video, ready to drag onto the video track"/>
                        <Button x:Name="VideoOpenBtn" Content="📂 Show file" Click="VideoOpen_Click" Padding="10,4" Margin="6,0,0,0"
                                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="VideoStatus" Text="No clip yet — write a prompt and hit Generate Video." Foreground="#8A90A0" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="🔑 Keys &amp; Compute" Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="InfoText" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                        <Border x:Name="KeyPanel" BorderBrush="#2A3446" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="KeyHint" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="KeyBox" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"/>
                                    <Button Grid.Column="1" Content="Save Key" Click="SaveKey_Click" Margin="8,0,0,0" Padding="12,4"
                                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock x:Name="KeyStatus" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#69F0AE" FontSize="11"/>
                                </Grid>
                                <Grid x:Name="CustomUrlRow" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Base URL" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A0A5B5" FontSize="11"/>
                                    <TextBox x:Name="CustomUrlBox" Grid.Column="1" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"
                                             ToolTip="e.g. http://localhost:1234/v1 for LM Studio"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Compute" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ComputePicker" Width="160" SelectionChanged="ComputePicker_SelectionChanged">
                                <ComboBoxItem Content="Auto (recommended)"/>
                                <ComboBoxItem Content="CPU only"/>
                                <ComboBoxItem Content="GPU"/>
                                <ComboBoxItem Content="☁️ Online"/>
                            </ComboBox>
                            <ComboBox x:Name="GpuPicker" Width="230" Margin="8,0,0,0" SelectionChanged="GpuPicker_SelectionChanged"/>
                            <TextBlock x:Name="ComputeInfo" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#A0A5B5" FontSize="11"/>
                        </StackPanel>
                        <Border x:Name="OnlinePanel" BorderBrush="#2A3446" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Online compute runs on a cloud provider (Demucs for stems; ACE-Step for songs). Replicate — paid per run. Hugging Face — FREE tier. fal.ai — paid per run. Keys are stored encrypted on this PC and only ever sent to the provider you picked."
                                           Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Provider" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="OnlineProviderPicker" Width="290" SelectionChanged="OnlineProviderPicker_SelectionChanged">
                                        <ComboBoxItem Content="Replicate — paid, fast, reliable"/>
                                        <ComboBoxItem Content="Hugging Face — FREE tier, slower"/>
                                        <ComboBoxItem Content="fal.ai — paid, fast (songs + stems)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="🆕 Sign up for Replicate (free)" Click="ReplicateSignup_Click" Padding="12,4"
                                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="🔑 Replicate API token" Click="ReplicateToken_Click" Margin="8,0,0,0" Padding="12,4"
                                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="🆓 Free Hugging Face token" Click="HfToken_Click" Margin="8,0,0,0" Padding="12,4"
                                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="🆕 Sign up for fal.ai" Click="FalSignup_Click" Margin="8,0,0,0" Padding="12,4"
                                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="🔑 fal.ai API keys" Click="FalKeys_Click" Margin="8,0,0,0" Padding="12,4"
                                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="OnlineKeyBox" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"/>
                                    <Button Grid.Column="1" Content="Save Key" Click="OnlineSaveKey_Click" Margin="8,0,0,0" Padding="12,4"
                                            Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock x:Name="OnlineKeyStatus" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#69F0AE" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Compute applies to the Stem Splitter and Create Song today, and to the local song-generation engine when it's set up. Auto uses the GPU when a real graphics card is present; Online uses the cloud instead."
                                   Foreground="#666666" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
