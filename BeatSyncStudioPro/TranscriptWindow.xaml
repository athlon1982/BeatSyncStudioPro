<Window x:Class="BeatSyncStudioPro.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcript" Icon="/Assets/app.ico"
        Width="640" Height="560" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="📝 Transcript" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="Transcribe a clip's vocals with Whisper (runs on your PC, nothing uploaded). Click any line to loop that exact section on the timeline. Sung vocals are harder than speech — expect to tidy up the words."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="ClipPicker"/>
            <Button Grid.Column="1" x:Name="TranscribeButton" Content="🎙️ Transcribe" Click="Transcribe_Click" Height="30" Padding="14,0" Margin="8,0,0,0"
                    Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <ProgressBar x:Name="BusyBar" Height="6" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" Background="#14171E" Foreground="#1DB954"/>
        <TextBlock x:Name="StatusText" Text="" Foreground="#A0A5B5" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <ListBox x:Name="SegmentList" Height="330" Margin="0,8,0,0" Background="#14171E" BorderBrush="#333"
                 SelectionChanged="SegmentList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save .txt" Click="SaveTxt_Click" Height="30" Padding="12,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Save .srt" Click="SaveSrt_Click" Height="30" Padding="12,0" Margin="8,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
