<Window x:Class="BeatSyncStudioPro.EnvelopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Envelope" Icon="/Assets/app.ico"
        Width="660" Height="360" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="TitleText" Text="📉 Volume Envelope" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="Click to add a point • drag points to shape the volume • right-click a point to delete it. The dashed line is normal volume (1.0); the top is 1.5×."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
        <Border BorderBrush="#333" BorderThickness="1" Background="#14171E">
            <Canvas x:Name="Plot" Width="624" Height="190" MouseLeftButtonDown="Plot_MouseLeftButtonDown"
                    MouseMove="Plot_MouseMove" MouseLeftButtonUp="Plot_MouseLeftButtonUp" MouseRightButtonDown="Plot_MouseRightButtonDown"/>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Presets:" VerticalAlignment="Center" Foreground="#A0A5B5" Margin="0,0,8,0"/>
            <Button Content="Flat" Click="PresetFlat_Click" Height="28" Padding="10,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Fade In" Click="PresetFadeIn_Click" Height="28" Padding="10,0" Margin="6,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Fade Out" Click="PresetFadeOut_Click" Height="28" Padding="10,0" Margin="6,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Duck Middle" Click="PresetDuck_Click" Height="28" Padding="10,0" Margin="6,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Swell" Click="PresetSwell_Click" Height="28" Padding="10,0" Margin="6,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="84" Height="32" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Apply" Click="Ok_Click" Width="84" Height="32" Margin="8,0,0,0" Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
