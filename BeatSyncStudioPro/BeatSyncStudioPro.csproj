<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>3.74.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\splash.png" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\soundpack.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- v3.56: bundled self-authored MilkDrop presets for the projectM scene -->
    <Content Include="Assets\presets\*.milk">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- v3.56: libprojectM engine (LGPL-2.1) ships as a loose, replaceable
         DLL beside the exe — never linked into the app. Binary: local + PC
         only, like the splash/icon art (text-only GitHub push). -->
    <Content Include="Native\projectM.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>projectM.dll</Link>
    </Content>
    <!-- glew32.dll: the OpenGL loader libprojectM depends on (GLEW 2.2.0,
         x64). Also a loose binary beside the exe; local + PC only. -->
    <Content Include="Native\glew32.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>glew32.dll</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The changelog ships INSIDE the program and is read by the Changelog window -->
    <EmbeddedResource Include="CHANGELOG.md" />
  </ItemGroup>

</Project>
