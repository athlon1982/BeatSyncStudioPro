<Window x:Class="BeatSyncStudioPro.VideoExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Video" Icon="/Assets/app.ico"
        Width="480" Height="220" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18">
        <TextBlock Text="🎬 Exporting Video" FontSize="15" FontWeight="Bold"/>
        <TextBlock x:Name="PhaseText" Text="Preparing…" Foreground="#A0A5B5" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Height="18" Margin="0,12,0,0"
                     Background="#14171E" Foreground="#1DB954" BorderThickness="0"/>
        <TextBlock x:Name="ResultText" Text="" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Width="84" Height="32"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="CloseButton" Content="Close" Click="Close_Click" Width="84" Height="32" Margin="8,0,0,0"
                    Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
