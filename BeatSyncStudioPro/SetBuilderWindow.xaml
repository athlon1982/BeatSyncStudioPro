<Window x:Class="BeatSyncStudioPro.SetBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Builder — BeatSync Studio Pro" Width="1060" Height="640" MinWidth="880" MinHeight="480"
        Background="#1E222B" Foreground="White" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#2A303C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A5B5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🧺 Set Builder" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Crates -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="CRATES" FontWeight="Bold" Foreground="#A0A5B5" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="＋ New" Style="{StaticResource Btn}" Click="NewCrate_Click"/>
                    <Button Content="🗑 Delete" Style="{StaticResource Btn}" Margin="0" Click="DeleteCrate_Click"/>
                </StackPanel>
                <ListBox x:Name="CrateList" Background="#14171E" Foreground="White" BorderThickness="0"
                         SelectionChanged="CrateList_SelectionChanged"/>
            </DockPanel>

            <!-- Crate contents -->
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="CrateNameText" DockPanel.Dock="Top" Text="Pick or create a crate" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⬆ Up" Style="{StaticResource Btn}" Click="MoveUp_Click"/>
                        <Button Content="⬇ Down" Style="{StaticResource Btn}" Click="MoveDown_Click"/>
                        <Button Content="✖ Remove" Style="{StaticResource Btn}" Click="RemoveItem_Click"/>
                        <Button Content="📈 Sort by BPM" Style="{StaticResource Btn}" Margin="0" Click="SortBpm_Click"
                                ToolTip="Order the crate slowest to fastest — an energy ramp. Songs without a BPM go last."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="▶ Queue Whole Crate on Deck A" Style="{StaticResource Btn}" Background="#1DB954" FontWeight="Bold" Click="SendA_Click"
                                ToolTip="Appends every song in this crate, in order, to Deck A's track list — then Auto-play or Cruise plays your set."/>
                        <Button Content="▶ Queue on Deck B" Style="{StaticResource Btn}" Background="#7C4DFF" FontWeight="Bold" Margin="0" Click="SendB_Click"/>
                    </StackPanel>
                </StackPanel>
                <DataGrid x:Name="ItemGrid" Background="#14171E" Foreground="White" BorderThickness="0"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowBackground="#1B1F28" AlternatingRowBackground="#14171E" GridLinesVisibility="None"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="BPM" Binding="{Binding BpmText}" Width="52"/>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="64"/>
                        <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="56"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Library browser -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="SONG LIBRARY — click songs, then Add" FontWeight="Bold" Foreground="#A0A5B5" Margin="0,0,0,6"/>
                <TextBox x:Name="LibFilter" DockPanel.Dock="Top" Background="#14171E" Foreground="White" BorderThickness="0"
                         Padding="6,4" Margin="0,0,0,6" TextChanged="LibFilter_TextChanged"/>
                <Button DockPanel.Dock="Bottom" Content="➕ Add Selected to Crate" Style="{StaticResource Btn}" Margin="0,6,0,0"
                        Background="#1DB954" FontWeight="Bold" Click="AddSelected_Click"/>
                <ListBox x:Name="LibList" Background="#14171E" Foreground="White" BorderThickness="0"
                         SelectionMode="Extended" MouseDoubleClick="LibList_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SubLine}" Foreground="#A0A5B5" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
