<Window x:Class="BeatSyncStudioPro.BatchConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Convert" Icon="/Assets/app.ico"
        Width="560" Height="520" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="🔁 Batch Convert" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="Convert a pile of WAV/MP3 files in one go — pick the files, the format, and hit Convert."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>

        <ListBox x:Name="FileList" Height="170" Background="#14171E" BorderBrush="#333" Foreground="White"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="➕ Add Files…" Click="AddFiles_Click" Height="30" Padding="12,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Remove" Click="Remove_Click" Height="30" Padding="12,0" Margin="8,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Clear" Click="Clear_Click" Height="30" Padding="12,0" Margin="8,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <TextBlock Text="Output format" FontWeight="Bold" Margin="0,14,0,4"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="FormatWav" Content="WAV (16-bit)" Foreground="White" IsChecked="True"/>
            <RadioButton x:Name="FormatMp3" Content="MP3 (192 kbps)" Foreground="White" Margin="16,0,0,0"/>
        </StackPanel>
        <CheckBox x:Name="LoudnessCheck" Content="Normalize loudness to -14 LUFS while converting" Foreground="White" Margin="0,10,0,0"/>

        <TextBlock Text="Output folder (blank = same folder as each file, name + '-converted')" FontWeight="Bold" Margin="0,14,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"/>
            <Button Grid.Column="1" Content="Browse…" Click="BrowseFolder_Click" Height="28" Padding="10,0" Margin="8,0,0,0"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <ProgressBar x:Name="OverallProgress" Height="8" Margin="0,16,0,0" Minimum="0" Maximum="100" Background="#14171E" Foreground="#1DB954"/>
        <TextBlock x:Name="StatusText" Text="" Foreground="#A0A5B5" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Width="84" Height="32" IsEnabled="False"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="ConvertButton" Content="Convert" Click="Convert_Click" Width="96" Height="32" Margin="8,0,0,0"
                    Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
