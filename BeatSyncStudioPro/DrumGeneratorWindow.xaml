<Window x:Class="BeatSyncStudioPro.DrumGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drum Generator" Icon="/Assets/app.ico"
        Width="480" Height="430" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="🤖 Drum Generator" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="Pick a style and get a ready-to-edit pattern in the step sequencer — beats land with per-step velocities, ghosts and all. Nothing is locked; tweak every step."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"/>

        <TextBlock Text="Style" FontWeight="Bold"/>
        <ComboBox x:Name="StylePicker" Margin="0,4,0,10" SelectionChanged="StylePicker_SelectionChanged"/>

        <Grid>
            <TextBlock Text="BPM" FontWeight="Bold"/>
            <TextBox x:Name="BpmBox" Width="60" HorizontalAlignment="Right" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,3"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <TextBlock Text="Density" FontWeight="Bold"/>
            <TextBlock x:Name="DensityLabel" Text="70%" HorizontalAlignment="Right" Foreground="#A0A5B5" FontSize="11"/>
        </Grid>
        <Slider x:Name="DensitySlider" Minimum="10" Maximum="100" Value="70" Margin="0,4,0,0"/>
        <TextBlock Text="How many variation hits and extras sneak in." Foreground="#666666" FontSize="10"/>

        <CheckBox x:Name="HumanizeCheck" Content="Humanize velocities (hits vary in strength — the grid stays quantized)" Foreground="White" Margin="0,12,0,0" IsChecked="True"/>

        <Button Content="🥁 Generate Pattern" Click="Generate_Click" Height="36" Margin="0,16,0,0"
                Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

        <Separator Margin="0,16,0,10" Background="#333"/>
        <TextBlock Text="🎒 Starter Loop Pack" FontWeight="Bold"/>
        <TextBlock Text="Four ready 4-bar loops (boom-bap, trap, house, funk) rendered straight into your library — drag them onto the timeline anytime."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6"/>
        <Button x:Name="PackButton" Content="🎒 Add Starter Loops to Library" Click="Pack_Click" Height="32"
                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        <TextBlock x:Name="StatusText" Text="" Foreground="#A0A5B5" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
