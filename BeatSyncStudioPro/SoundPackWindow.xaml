<Window x:Class="BeatSyncStudioPro.SoundPackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Pack — Built-in Sounds" Icon="/Assets/app.ico"
        Width="660" Height="540" MinWidth="520" MinHeight="400"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎁 Sound Pack — built into BeatSync" FontSize="16" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Text="Drums, guitar, bass, keys, loops and FX — synthesized for BeatSync, free to use in your music with no credit needed. Sounds stay compressed in the pack until you add them."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <ListBox x:Name="PackList" Grid.Row="2" Margin="0,10,0,0" Background="#14171E" Foreground="White" BorderBrush="#333"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="▶ Preview" Click="Preview_Click" Padding="14,6"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="⬇ Add to Library" Click="Add_Click" Margin="8,0,0,0" Padding="14,6"
                    Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="⬇⬇ Add Whole Category" Click="AddCategory_Click" Margin="8,0,0,0" Padding="14,6"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,8,0,0" Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</Window>
