<Window x:Class="BeatSyncStudioPro.RenderQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Render Queue" Icon="/Assets/app.ico"
        Width="600" Height="470" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="📋 Render Queue" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="Line up several exports of the current project — different bundles, names or formats — then render them all in one run. Each entry snapshots the timeline as it is when you add it."
                   Foreground="#A0A5B5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>

        <ListBox x:Name="QueueList" Height="240" Background="#14171E" BorderBrush="#333">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#A0A5B5" FontSize="11" Margin="16,0,4,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="➕ Add Export…" Click="AddEntry_Click" Height="30" Padding="12,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Remove" Click="Remove_Click" Height="30" Padding="12,0" Margin="8,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Clear Done" Click="ClearDone_Click" Height="30" Padding="12,0" Margin="8,0,0,0" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Text="" Foreground="#A0A5B5" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Width="84" Height="32" IsEnabled="False"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="RenderButton" Content="▶ Render All" Click="RenderAll_Click" Width="110" Height="32" Margin="8,0,0,0"
                    Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
