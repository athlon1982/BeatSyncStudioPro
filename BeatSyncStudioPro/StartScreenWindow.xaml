<Window x:Class="BeatSyncStudioPro.StartScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to BeatSync Studio Pro" Icon="/Assets/app.ico"
        Width="620" Height="520" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="🎵 BeatSync Studio Pro" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Created by Michael DeCato" Foreground="#FFC83D" FontSize="12" Margin="0,2,0,0"/>
            <TextBlock Text="What do you want to make?" FontSize="14" Margin="0,12,0,8"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Rows="3">
            <Button Margin="4" Height="52" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Blank_Click"
                    Content="🎵  Blank Project — start empty" HorizontalContentAlignment="Left" Padding="12,0"/>
            <Button Margin="4" Height="52" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BeatSession_Click"
                    Content="🥁  Beat Session — 4 tracks, 95 BPM grid" HorizontalContentAlignment="Left" Padding="12,0"/>
            <Button Margin="4" Height="52" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SongVocals_Click"
                    Content="🎤  Song + Vocals — 3 tracks, 90 BPM grid" HorizontalContentAlignment="Left" Padding="12,0"/>
            <Button Margin="4" Height="52" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="VideoSoundtrack_Click"
                    Content="🎬  Video Soundtrack — import a video" HorizontalContentAlignment="Left" Padding="12,0"/>
            <Button Margin="4" Height="52" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="DjPrep_Click"
                    Content="🎧  DJ Prep — 2 tracks + DJ decks open" HorizontalContentAlignment="Left" Padding="12,0"/>
            <Button Margin="4" Height="52" Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="OpenProject_Click"
                    Content="📂  Open a Project File…" HorizontalContentAlignment="Left" Padding="12,0"/>
        </UniformGrid>

        <StackPanel Grid.Row="2" Margin="4,10,4,0">
            <TextBlock Text="Recent projects" FontWeight="Bold" FontSize="12"/>
            <ListBox x:Name="RecentList" Height="110" Margin="0,6,0,0" Background="#14171E" BorderBrush="#333"
                     MouseDoubleClick="RecentList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="White" ToolTip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoRecentText" Text="No recent projects yet — saved and opened projects will show up here."
                       Foreground="#666666" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="4,10,4,0">
            <CheckBox x:Name="ShowAtStartupCheck" Content="Show this screen at startup" Foreground="White" VerticalAlignment="Center"
                      Checked="ShowAtStartup_Changed" Unchecked="ShowAtStartup_Changed"/>
            <Button Content="Close" Width="84" Height="32" HorizontalAlignment="Right" Background="#1DB954" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
