<Window x:Class="BeatSyncStudioPro.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette" Icon="/Assets/app.ico"
        Width="540" Height="430" ResizeMode="NoResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" FontSize="14" Padding="8,6" Background="#14171E" Foreground="White" BorderBrush="#333"
                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
        <ListBox x:Name="ResultsList" Grid.Row="1" Margin="0,8,0,0" Background="#14171E" BorderBrush="#333"
                 MouseDoubleClick="ResultsList_MouseDoubleClick" PreviewKeyDown="ResultsList_PreviewKeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding Hotkey}" Foreground="#A0A5B5" FontSize="11" Margin="20,0,4,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="Type to filter • ↑↓ to browse • Enter to run • Esc to close" Foreground="#666666" FontSize="10" Margin="0,6,0,0"/>
    </Grid>
</Window>
