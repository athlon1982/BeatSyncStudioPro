<Window x:Class="BeatSyncStudioPro.PatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pattern — Step Sequencer" Icon="/Assets/app.ico"
        Width="860" Height="560" ResizeMode="CanResize"
        Background="#1E222B" Foreground="#FFFFFF" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="🥁 Pattern" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="PatternPicker" Width="160" Margin="14,0,0,0" SelectionChanged="PatternPicker_SelectionChanged"/>
            <Button Content="➕ New Pattern" Click="NewPattern_Click" Height="30" Padding="10,0" Margin="8,0,0,0"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="🎒 Kit from Files…" Click="KitFromFiles_Click" Height="30" Padding="10,0" Margin="8,0,0,0"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"
                    ToolTip="Pick your own WAV/MP3 files — each becomes a drum channel in a new pattern"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <Button x:Name="PlayButton" Content="▶ Play" Click="Play_Click" Width="84" Height="34"
                    Background="#1DB954" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="⏹ Stop" Click="Stop_Click" Width="84" Height="34" Margin="8,0,0,0"
                    Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <TextBlock Text="BPM" VerticalAlignment="Center" Margin="18,0,6,0" Foreground="#A0A5B5"/>
            <TextBox x:Name="BpmBox" Width="56" VerticalAlignment="Center" Background="#14171E" Foreground="White" BorderBrush="#333" Padding="6,4"/>
            <TextBlock Text="Render" VerticalAlignment="Center" Margin="18,0,6,0" Foreground="#A0A5B5"/>
            <ComboBox x:Name="BarsPicker" Width="86" IsEditable="True" Text="4"
                      ToolTip="Bars to render — pick a preset or type any number (up to 999)">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="32"/>
                <ComboBoxItem Content="64"/>
                <ComboBoxItem Content="128"/>
            </ComboBox>
            <Button Content="🎵 Render to Timeline" Click="Render_Click" Height="34" Padding="12,0" Margin="8,0,0,0"
                    Background="#2A303C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel"/>
        </ScrollViewer>

        <Button Grid.Row="3" Content="➕ Add Channel" Click="AddChannel_Click" Height="30" Margin="0,8,0,0"
                Background="#2A303C" Foreground="White" BorderThickness="0" Cursor="Hand"/>

        <TextBlock Grid.Row="4" x:Name="StatusText" Text="Click steps to build a beat. Channels can use the built-in drums or any sound in your library."
                   Foreground="#A0A5B5" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
